{
  "compilerOptions": {
      "target": "es2022",
      "module": "es2022",
      "moduleResolution": "bundler",
      "skipLibCheck": true,
      "allowJs": true,
      "strict": true,
      "strictPropertyInitialization": false,
      "typeRoots": [
        "./node_modules/@types"
      ],
      "paths": {
          "<%= libraryNamespaceURI %>/*": [
              "./src/<%= libraryNamespaceURI %>/*"
          ]
      }
  },
  "include": [
      "./src/**/*",
      "./test/**/*",
      "./node_modules/<%- tsTypes %>/types/index.d.ts"
  ]
}