  "../opa-with-mock/ui5-mock.yaml": Object {
    "contents": "# yaml-language-server: $schema=https://sap.github.io/ui5-tooling/schema/ui5.yaml.json

specVersion: \\"3.1\\"
metadata:
  name: my.test.app
type: application
resources:
  configuration:
    propertiesFileSourceEncoding: UTF-8
    paths:
      webapp: webapp
customConfiguration:
  adp:
    support:
      id: '@package/name'
      version: 0.0.1
      toolsId: uuidv4
server:
  customMiddleware:
    - name: fiori-tools-appreload
      afterMiddleware: compression
      configuration:
        port: 35729
        path: webapp
        delay: 300
    - name: fiori-tools-preview
      afterMiddleware: fiori-tools-appreload
      configuration:
        # NO component: property for an ADP — the adp block loads base + variant
        ui5Theme: sap_horizon
        adp:
          target:
            client: '000'
            url: http://sap.example
            authenticationType: basic
          ignoreCertErrors: false
    - name: fiori-tools-proxy
      afterMiddleware: fiori-tools-preview
      configuration:
        ignoreCertError: false # If set to true, certificate errors will be ignored. E.g. self-signed certificates will be accepted
        backend:
          - client: '000'
            url: http://sap.example
            authenticationType: basic
            path: /sap
        ui5:
          path:
            - /resources
            - /test-resources
          url: https://ui5.sap.com
          version: 1.133.1
    - name: sap-fe-mockserver
      beforeMiddleware: csp
      configuration:
        mockFolder: ./webapp/localService/
        watch: true
        debug: true
      mountPath: /
",
    "state": "modified",
  },
  "../opa-with-mock/ui5.yaml": Object {
    "contents": "# yaml-language-server: $schema=https://sap.github.io/ui5-tooling/schema/ui5.yaml.json

specVersion: \\"4.0\\"
metadata:
  name: my-test-app
type: application
resources:
  configuration:
    propertiesFileSourceEncoding: UTF-8
customConfiguration:
  adp:
    support:
      id: '@package/name'
      toolsId: uuidv4
      version: 0.0.1
server:
  customMiddleware:
    - name: fiori-tools-appreload
      afterMiddleware: compression
      configuration:
        port: 35729
        path: webapp
        delay: 300
    - name: fiori-tools-preview
      afterMiddleware: fiori-tools-appreload
      configuration:
        adp:
          target:
            url: http://sap.example
            client: '000'
          ignoreCertErrors: false
        flp:
          useNewSandbox: true
    - name: fiori-tools-proxy
      afterMiddleware: fiori-tools-preview
      configuration:
        ignoreCertErrors: false # If set to true, certificate errors will be ignored. E.g. self-signed certificates will be accepted
        backend:
          - url: http://sap.example
            client: '000'
            path: /sap
        ui5:
          path:
            - /resources
            - /test-resources
          url: https://ui5.sap.com
          version: 1.133.1
builder:
  resources:
    excludes:
      - /test/**
      - /localService/**
",
