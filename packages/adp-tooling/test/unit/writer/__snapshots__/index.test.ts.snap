    <div id=\\"qunit-fixture\\"></div>
</body>
</html>
",
    "state": "modified",
  },
  "webapp/test/integration/opaTests.qunit.js": Object {
    "contents": "QUnit.config.autostart = false;
QUnit.config.testTimeout = 150000;
var oUriParameters = new URLSearchParams(window.location.search);
var sJourney = oUriParameters.get(\\"journey\\");
var sPrerequisiteModules = [
    \\"sap/fe/test/JourneyRunner\\"
];

sap.ui.require(sPrerequisiteModules, function (JourneyRunnerClass) {
    fetch(\\"AllJourneys.json\\").then(function (oResponse) {
        if (!oResponse.ok) {
            throw new Error(\\"Failed to load AllJourneys.json: \\" + oResponse.status + \\" \\" + oResponse.statusText);
        }
        return oResponse.json();
    }).then(function (aAllJourneys) {
        var adpNs = \\"my/test/app\\";
        var aJourneys = aAllJourneys.filter(function (name) {
            return !sJourney || sJourney === name;
        }).map(function (name) {
            return adpNs + \\"/test/integration/\\" + name;
        });

        sap.ui.require(aJourneys, function () {
            var aJourneyModules = Array.prototype.slice.call(arguments);
            var testPath = adpNs + \\"/test\\"; 
            var sLaunchUrl = oUriParameters.get(\\"env\\") === \\"karma\\"
                ? sap.ui.require.toUrl(testPath) + \\"/flpSandbox.html?sap-ui-xx-viewCache=false#<FLP_INTENT>\\"
                : sap.ui.require.toUrl(testPath) + \\"/flp.html?sap-ui-xx-viewCache=false#app-preview\\";

            var JourneyRunner = new JourneyRunnerClass({
                launchUrl: sLaunchUrl
            });

            JourneyRunner.run(
                {
                    pages: {}
                },
                aJourneyModules.map(function (oJourney) { return oJourney.run; })
            );
            QUnit.start();
        });
    });
});
",
    "state": "modified",
  },
  "webapp/test/locate-reuse-libs.js": Object {
    "contents": "// This script is required by the Fiori pipeline to locate and register reuse libraries.
// The pipeline downloads the reuse libraries and places them in webapp/resources.
(function () {
    \\"use strict\\";

    var oScript = document.getElementById(\\"locate-reuse-libs\\");
    var sManifestUri = oScript && oScript.getAttribute(\\"data-sap-ui-manifest-uri\\");

    if (!sManifestUri) {
        return;
    }

    var oXhr = new XMLHttpRequest();
    oXhr.open(\\"GET\\", sManifestUri, false);
    oXhr.send(null);

    if (oXhr.status !== 200) {
        return;
    }

    var oManifest;
    try {
        oManifest = JSON.parse(oXhr.responseText);
    } catch (e) {
        return;
    }

    var oLibs = (oManifest[\\"sap.ui5\\"] || {})[\\"dependencies\\"] || {};
    var mLibraries = oLibs[\\"libs\\"] || {};

    Object.keys(mLibraries).forEach(function (sLib) {
        if (mLibraries[sLib][\\"lazy\\"] !== true) {
            var sPath = \\"../../resources/\\" + sLib.replace(/\\\\./g, \\"/\\");
            var oExistingPath = window[\\"sap-ui-config\\"] && window[\\"sap-ui-config\\"][\\"paths\\"];
            if (!oExistingPath || !oExistingPath[sLib]) {
                window[\\"sap-ui-config\\"] = window[\\"sap-ui-config\\"] || {};
                window[\\"sap-ui-config\\"][\\"paths\\"] = window[\\"sap-ui-config\\"][\\"paths\\"] || {};
                window[\\"sap-ui-config\\"][\\"paths\\"][sLib] = sPath;
            }
        }
    });
}());
",
    "state": "modified",
  },
  "webapp/test/testsuite.qunit.html": Object {
    "contents": "<!DOCTYPE html>
<html>
  <head>
    <title>QUnit test suite</title>
    <script src=\\"../resources/sap/ui/qunit/qunit-redirect.js\\"></script>
    <script src=\\"testsuite.qunit.js\\" data-sap-ui-testsuite></script>
  </head>
  <body></body>
</html>
",
    "state": "modified",
  },
  "webapp/test/testsuite.qunit.js": Object {
    "contents": "window.suite = function () {
    'use strict';

    // eslint-disable-next-line
    var oSuite = new parent.jsUnitTestSuite(),
        sContextPath = location.pathname.substring(0, location.pathname.lastIndexOf('/') + 1);
    var xhr = new XMLHttpRequest();

    xhr.open(\\"GET\\", \\"integration/AllJourneys.json\\", false);
    xhr.send(null);
    JSON.parse(xhr.responseText).forEach(function (name) {
        oSuite.addTestPage(sContextPath + \\"integration/opaTests.qunit.html?journey=\\" + name + \\"&env=karma\\");
    });

    return oSuite;
};
",
    "state": "modified",
  },
}
`;

