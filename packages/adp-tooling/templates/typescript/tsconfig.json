{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "<%= id %>/*": ["./webapp/*"]
    }
  },
  "include": [
    "./webapp/**/*",
    "./node_modules/<%- typesPackage %>/types/index.d.ts"
  ]
}