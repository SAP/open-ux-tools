<%
    const $isOpaTestingEnabled = locals.options?.addOpaTests;
    const $uxUi5ToolingVersion = $isOpaTestingEnabled ? "^1.25.0" : "1";
    const $taskAdaptationVersion = $isOpaTestingEnabled ? "^1.6.5" : "^1.3.0";
    const $ui5CliVersion = $isOpaTestingEnabled ? "^4.0.55" : "^4.0.33";
%>
{
    "name": "<%= package.name %>",
    "version": "0.1.0",
    "private": true,
    "description": "<%= package.description %>",
    "keywords": [
        "ui5",
        "sapui5",
        "adaptation-project"
    ],
    "dependencies": {}<% if ($isOpaTestingEnabled) { %>,
    "overrides": {
        "@sap-ux/axios-extension": "1.25.35"
    }<% } %>,
    "devDependencies": {<% if (locals.options?.fioriTools) { %>
        "@sap/ux-ui5-tooling": "<%= $uxUi5ToolingVersion %>"<% } else { %>
        "@sap-ux/backend-proxy-middleware": "^0.7.5",
        "@sap-ux/preview-middleware": "^0.11.1",
        "@sap-ux/ui5-proxy-middleware": "^1.3.0",
        "@sap-ux/deploy-tooling": "^0.11.7"<% } %>,
        "@ui5/task-adaptation": "<%= $taskAdaptationVersion %>",
        "@ui5/cli": "<%= $ui5CliVersion %>"<% if (locals.options?.enableTypeScript) { %>,
        "<%- typesPackage %>": "<%- typesVersion %>",
        "typescript": "^5.7.3",
        "ui5-tooling-transpile": "^3.6.1"<% } %><% if ($isOpaTestingEnabled) { %>,
        "@sap-ux/ui5-middleware-fe-mockserver": "^2.4.13",
        "@babel/eslint-parser": "7.14.7",
        "@sap-ux/eslint-plugin-fiori-tools": "^0.4.0",
        "eslint": "8.57.0",
        "eslint-plugin-fiori-custom": "2.6.7"<% } %>
    },
    "scripts": {
        "build": "ui5 build<%if (!locals.app?.bspName) {%> --exclude-task generateFlexChangesBundle generateComponentPreload minify<%}%> --clean-dest",
        "start": "<%= locals.options?.fioriTools ? 'fiori run' : 'ui5 serve' %> --open /test/flp.html#app-preview",
        "start-editor": "<%= locals.options?.fioriTools ? 'fiori run' : 'ui5 serve' %> --open /test/adaptation-editor.html"<% if ($isOpaTestingEnabled) { %>,
        "int-test": "fiori run --config ./ui5-mock.yaml --open \"test/integration/opaTests.qunit.html\"",
        "lint": "eslint ./ --no-error-on-unmatched-pattern"<% } %><% if (locals.deploy) { %>,
        "deploy": "npm run build && <%= locals.options?.fioriTools ? 'fiori deploy' : 'deploy' %> --config ui5-deploy.yaml",
        "undeploy": "npm run build && <%= locals.options?.fioriTools ? 'fiori undeploy' : 'undeploy' %> --config ui5-deploy.yaml",
        "deploy-test": "npm run build && fiori deploy --config ui5-deploy.yaml --testMode true"<% } %>
    }
}
