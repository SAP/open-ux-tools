{
    "compilerOptions": {
        "target": "es2022",
        "module": "es2022",
        "skipLibCheck": true,
        "allowJs": true,
        "strict": true,
        "strictPropertyInitialization": false,
        "moduleResolution": "bundler",
        "paths": {
            "<%-app.id.replace(/\./g, '/') %>/*": [
                "./webapp/*"
            ]
        },
        "typeRoots": [
            "./node_modules/@types"
        ]
    },
    "include": [
        "./webapp/**/*",
        "./node_modules/<%- ui5.typesPackage %>/types/index.d.ts"
    ]
}