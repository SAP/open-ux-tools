{
    "name": "sap-ux-adp-editor-launcher-ext",
    "version": "0.0.1",
    "displayName": "ADP Editor Launcher",
    "description": "Opens the SAP Fiori adaptation editor in the built-in Simple Browser so interactive logins (e.g. multi-IdP Cloud Foundry approuter) can be completed while the Fiori MCP ADP RTA workflow runs.",
    "main": "./dist/extension.js",
    "publisher": "SAPOSS",
    "repository": {
        "type": "git",
        "url": "https://github.com/SAP/open-ux-tools.git",
        "directory": "packages/adp-editor-launcher-ext"
    },
    "engines": {
        "vscode": "^1.110.0",
        "node": ">=22.x"
    },
    "files": [
        "dist/**/*.{js,css,LICENSES.txt,LEGAL.txt}",
        "LICENSE"
    ],
    "scripts": {
        "vscode:prepublish": "pnpm run build",
        "build": "npm-run-all -l -s clean -p check-types bundle:dev",
        "bundle:dev": "node esbuild.js --development",
        "bundle:prod": "node esbuild.js --production",
        "clean": "rimraf dist",
        "watch": "node esbuild.js --watch",
        "check-types": "tsc --noEmit",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "test": "node --test test/extension.test.cjs",
        "ide-ext:package": "vsce package"
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "dependencies": {},
    "devDependencies": {
        "@types/vscode": "1.110.0",
        "@vscode/vsce": "3.9.2",
        "cross-env": "10.1.0",
        "npm-run-all2": "9.0.2",
        "rimraf": "6.1.3"
    },
    "contributes": {
        "commands": [
            {
                "command": "sap.ux.adp.openEditorInSimpleBrowser",
                "title": "Fiori: Open ADP Editor in Simple Browser",
                "category": "SAP"
            }
        ]
    }
}
