        "sap.common": {
            "kind": "context"
        },
        "sap.common.Locale": {
            "kind": "type",
            "@title": "{i18n>LanguageCode}",
            "type": "cds.String",
            "length": 14
        },
        "sap.common.CodeList": {
            "kind": "aspect",
