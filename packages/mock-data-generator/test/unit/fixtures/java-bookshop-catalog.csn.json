{
    "$source": "CSN of CatalogService compiled from https://github.com/SAP-samples/cloud-cap-samples-java (commit 55a55d1a2f42362aa03df6fb10be3533690d6d9e). License: Apache-2.0. Definitions unmodified.",
    "definitions": {
        "my.bookshop.TechnicalBooleanFlag": {
            "kind": "type",
            "@UI.Hidden": true,
            "@Core.Computed": true,
            "type": "cds.Boolean"
        },
        "my.bookshop.Rating": {
            "kind": "type",
            "type": "cds.Integer",
            "enum": {
                "Best": {
                    "val": 5
                },
                "Good": {
                    "val": 4
                },
                "Avg": {
                    "val": 3
                },
                "Poor": {
                    "val": 2
                },
                "Worst": {
                    "val": 1
                }
            }
        },
        "CatalogService": {
            "kind": "service",
            "@path": "browse",
            "@odata.apply.transformations": true,
            "@requires": "any"
        },
        "CatalogService.Books": {
            "kind": "entity",
            "@readonly": true,
            "@fiori.draft.enabled": true,
            "projection": {
                "from": {
                    "ref": [
                        "my.bookshop.Books"
                    ]
                },
                "excluding": [
                    "createdBy",
                    "modifiedBy"
                ]
            },
            "elements": {
                "ID": {
                    "key": true,
                    "type": "cds.UUID"
                },
                "createdAt": {
                    "@cds.on.insert": {
                        "=": "$now"
                    },
                    "@UI.HiddenFilter": true,
                    "@UI.ExcludeFromNavigationContext": true,
                    "@Core.Immutable": true,
                    "@title": "{i18n>CreatedAt}",
                    "@readonly": true,
                    "type": "cds.Timestamp"
                },
                "modifiedAt": {
                    "@cds.on.insert": {
                        "=": "$now"
                    },
                    "@cds.on.update": {
                        "=": "$now"
                    },
                    "@UI.HiddenFilter": true,
                    "@UI.ExcludeFromNavigationContext": true,
                    "@title": "{i18n>ChangedAt}",
                    "@readonly": true,
                    "type": "cds.Timestamp"
                },
                "title": {
                    "localized": true,
                    "type": "cds.String",
                    "length": 111
                },
                "descr": {
                    "localized": true,
                    "type": "cds.String",
                    "length": 1111
                },
                "author": {
                    "type": "cds.Association",
                    "target": "CatalogService.Authors",
                    "keys": [
                        {
                            "ref": [
                                "ID"
                            ]
                        }
                    ]
                },
                "genre": {
                    "type": "cds.Association",
                    "target": "CatalogService.GenreHierarchy",
                    "keys": [
                        {
                            "ref": [
                                "ID"
                            ]
                        }
                    ]
                },
                "stock": {
                    "type": "cds.Integer"
                },
                "price": {
                    "type": "cds.Decimal",
                    "precision": 9,
                    "scale": 2
                },
                "currency": {
                    "@title": "{i18n>Currency}",
                    "@description": "{i18n>CurrencyCode.Description}",
                    "type": "Currency",
                    "target": "CatalogService.Currencies",
                    "keys": [
                        {
                            "ref": [
                                "code"
                            ]
                        }
                    ]
                },
                "rating": {
                    "type": "cds.Decimal",
                    "precision": 2,
                    "scale": 1
                },
                "reviews": {
                    "type": "cds.Association",
                    "cardinality": {
                        "max": "*"
                    },
                    "target": "CatalogService.Reviews",
                    "on": [
                        {
                            "ref": [
                                "reviews",
                                "book"
                            ]
                        },
                        "=",
                        {
                            "ref": [
                                "$self"
                            ]
                        }
                    ]
                },
                "isReviewable": {
                    "@UI.Hidden": true,
                    "@Core.Computed": true,
                    "type": "my.bookshop.TechnicalBooleanFlag",
                    "notNull": true,
                    "default": {
                        "val": true
                    }
                },
                "contents": {
                    "@odata.contained": false,
                    "type": "cds.Composition",
                    "cardinality": {
                        "max": "*"
                    },
                    "target": "CatalogService.Contents",
                    "on": [
                        {
                            "ref": [
                                "contents",
                                "book"
                            ]
                        },
                        "=",
                        {
                            "ref": [
                                "$self"
                            ]
                        }
                    ]
                },
                "texts": {
                    "type": "cds.Composition",
                    "cardinality": {
                        "max": "*"
                    },
                    "target": "CatalogService.Books.texts",
                    "on": [
                        {
                            "ref": [
                                "texts",
                                "ID"
                            ]
                        },
                        "=",
                        {
                            "ref": [
                                "ID"
                            ]
                        }
                    ]
                },
                "localized": {
                    "type": "cds.Association",
                    "target": "CatalogService.Books.texts",
                    "on": [
                        {
                            "ref": [
                                "localized",
                                "ID"
                            ]
                        },
                        "=",
                        {
                            "ref": [
                                "ID"
                            ]
                        },
                        "and",
                        {
                            "ref": [
                                "localized",
                                "locale"
                            ]
                        },
                        "=",
                        {
                            "ref": [
                                "$user",
                                "locale"
                            ]
                        }
                    ]
                }
            },
            "actions": {
                "addReview": {
                    "kind": "action",
                    "params": {
                        "rating": {
                            "type": "cds.Integer"
                        },
                        "title": {
                            "type": "cds.String"
                        },
                        "text": {
                            "type": "cds.String"
                        }
                    },
                    "returns": {
                        "type": "CatalogService.Reviews"
                    }
                }
            }
        },
        "CatalogService.Authors": {
            "kind": "entity",
            "@readonly": true,
            "@PersonalData.DataSubjectRole": "Author",
            "@PersonalData.EntitySemantics": "DataSubject",
            "projection": {
                "from": {
                    "ref": [
                        "my.bookshop.Authors"
                    ]
                }
            },
            "elements": {
                "ID": {
                    "@PersonalData.FieldSemantics": "DataSubjectID",
                    "key": true,
                    "type": "cds.UUID"
                },
                "createdAt": {
                    "@cds.on.insert": {
                        "=": "$now"
                    },
                    "@UI.HiddenFilter": true,
                    "@UI.ExcludeFromNavigationContext": true,
                    "@Core.Immutable": true,
                    "@title": "{i18n>CreatedAt}",
                    "@readonly": true,
                    "type": "cds.Timestamp"
                },
                "createdBy": {
                    "@cds.on.insert": {
                        "=": "$user"
                    },
                    "@UI.HiddenFilter": true,
                    "@UI.ExcludeFromNavigationContext": true,
                    "@Core.Immutable": true,
                    "@title": "{i18n>CreatedBy}",
                    "@readonly": true,
                    "@description": "{i18n>UserID.Description}",
                    "type": "User",
                    "length": 255
                },
                "modifiedAt": {
                    "@cds.on.insert": {
                        "=": "$now"
                    },
                    "@cds.on.update": {
                        "=": "$now"
                    },
                    "@UI.HiddenFilter": true,
                    "@UI.ExcludeFromNavigationContext": true,
                    "@title": "{i18n>ChangedAt}",
                    "@readonly": true,
                    "type": "cds.Timestamp"
                },
                "modifiedBy": {
                    "@cds.on.insert": {
                        "=": "$user"
                    },
                    "@cds.on.update": {
                        "=": "$user"
                    },
                    "@UI.HiddenFilter": true,
                    "@UI.ExcludeFromNavigationContext": true,
                    "@title": "{i18n>ChangedBy}",
                    "@readonly": true,
                    "@description": "{i18n>UserID.Description}",
                    "type": "User",
                    "length": 255
                },
                "name": {
                    "@assert.format": "^\\p{Lu}.*",
                    "@PersonalData.IsPotentiallySensitive": true,
                    "type": "cds.String",
                    "length": 111
                },
                "dateOfBirth": {
                    "type": "cds.Date"
                },
                "dateOfDeath": {
                    "type": "cds.Date"
                },
                "placeOfBirth": {
                    "type": "cds.String"
                },
                "placeOfDeath": {
                    "type": "cds.String"
                },
                "books": {
                    "type": "cds.Association",
                    "cardinality": {
                        "max": "*"
                    },
                    "target": "CatalogService.Books",
                    "on": [
                        {
                            "ref": [
                                "books",
                                "author"
                            ]
                        },
                        "=",
                        {
                            "ref": [
                                "$self"
                            ]
                        }
                    ]
                },
                "details": {
                    "type": "cds.Map"
                }
            }
        },
        "CatalogService.Reviews": {
            "kind": "entity",
            "@readonly": true,
            "@restrict": [
                {
                    "grant": "READ",
                    "to": "any"
                },
                {
                    "grant": "CREATE",
                    "to": "authenticated-user"
                }
            ],
            "projection": {
                "from": {
                    "ref": [
                        "my.bookshop.Reviews"
                    ]
                }
            },
            "elements": {
                "ID": {
                    "key": true,
                    "type": "cds.UUID"
                },
                "createdAt": {
                    "@cds.on.insert": {
                        "=": "$now"
                    },
                    "@UI.HiddenFilter": true,
                    "@UI.ExcludeFromNavigationContext": true,
                    "@Core.Immutable": true,
                    "@title": "{i18n>CreatedAt}",
                    "@readonly": true,
                    "type": "cds.Timestamp"
                },
                "createdBy": {
                    "@cds.on.insert": {
                        "=": "$user"
                    },
                    "@UI.HiddenFilter": true,
                    "@UI.ExcludeFromNavigationContext": true,
                    "@Core.Immutable": true,
                    "@title": "{i18n>CreatedBy}",
                    "@readonly": true,
                    "@description": "{i18n>UserID.Description}",
                    "type": "User",
                    "length": 255
                },
                "modifiedAt": {
                    "@cds.on.insert": {
                        "=": "$now"
                    },
                    "@cds.on.update": {
                        "=": "$now"
                    },
                    "@UI.HiddenFilter": true,
                    "@UI.ExcludeFromNavigationContext": true,
                    "@title": "{i18n>ChangedAt}",
                    "@readonly": true,
                    "type": "cds.Timestamp"
                },
                "modifiedBy": {
                    "@cds.on.insert": {
                        "=": "$user"
                    },
                    "@cds.on.update": {
                        "=": "$user"
                    },
                    "@UI.HiddenFilter": true,
                    "@UI.ExcludeFromNavigationContext": true,
                    "@title": "{i18n>ChangedBy}",
                    "@readonly": true,
                    "@description": "{i18n>UserID.Description}",
                    "type": "User",
                    "length": 255
                },
                "book": {
                    "@cds.odata.ValueList": true,
                    "@mandatory": true,
                    "@assert.target": true,
                    "type": "cds.Association",
                    "target": "CatalogService.Books",
                    "keys": [
                        {
                            "ref": [
                                "ID"
                            ]
                        }
                    ]
                },
                "rating": {
                    "@assert.range": true,
                    "type": "my.bookshop.Rating"
                },
                "title": {
                    "@mandatory": true,
                    "type": "cds.String",
                    "length": 111
                },
                "text": {
                    "type": "cds.String",
                    "length": 1111
                }
            }
        },
        "CatalogService.GenreHierarchy": {
            "kind": "entity",
            "@readonly": true,
            "@cds.autoexpose": true,
            "@cds.persistence.skip": "if-unused",
            "@UI.Identification": [
                {
                    "Value": {
                        "=": "name"
                    }
                }
            ],
            "@cds.odata.valuelist": true,
            "projection": {
                "from": {
                    "ref": [
                        "my.bookshop.Genres"
                    ]
                }
            },
            "elements": {
                "name": {
                    "@title": "{i18n>Name}",
                    "localized": true,
                    "type": "cds.String",
                    "length": 255
                },
                "descr": {
                    "@title": "{i18n>Description}",
                    "localized": true,
                    "type": "cds.String",
                    "length": 1000
                },
                "ID": {
                    "key": true,
                    "type": "cds.UUID"
                },
                "siblingRank": {
                    "type": "cds.Integer"
                },
                "parent": {
                    "type": "cds.Association",
                    "target": "CatalogService.GenreHierarchy",
                    "keys": [
                        {
                            "ref": [
                                "ID"
                            ]
                        }
                    ]
                },
                "children": {
                    "type": "cds.Composition",
                    "cardinality": {
                        "max": "*"
                    },
                    "target": "CatalogService.GenreHierarchy",
                    "on": [
                        {
                            "ref": [
                                "children",
                                "parent"
                            ]
                        },
                        "=",
                        {
                            "ref": [
                                "$self"
                            ]
                        }
                    ]
                },
                "texts": {
                    "type": "cds.Composition",
                    "cardinality": {
                        "max": "*"
                    },
                    "target": "CatalogService.GenreHierarchy.texts",
                    "on": [
                        {
                            "ref": [
                                "texts",
                                "ID"
                            ]
                        },
                        "=",
                        {
                            "ref": [
                                "ID"
                            ]
                        }
                    ]
                },
                "localized": {
                    "type": "cds.Association",
                    "target": "CatalogService.GenreHierarchy.texts",
                    "on": [
                        {
                            "ref": [
                                "localized",
                                "ID"
                            ]
                        },
                        "=",
                        {
                            "ref": [
                                "ID"
                            ]
                        },
                        "and",
                        {
                            "ref": [
                                "localized",
                                "locale"
                            ]
                        },
                        "=",
                        {
                            "ref": [
                                "$user",
                                "locale"
                            ]
                        }
                    ]
                }
            }
        },
        "CatalogService.submitOrder": {
            "kind": "action",
            "params": {
                "book": {
                    "type": {
                        "ref": [
                            "CatalogService.Books",
                            "ID"
                        ]
                    }
                },
                "quantity": {
                    "type": "cds.Integer"
                }
            },
            "returns": {
                "elements": {
                    "stock": {
                        "type": "cds.Integer"
                    }
                }
            }
        },
