                            ]
                        },
                        "=",
                        {
                            "ref": [
                                "$self"
                            ]
                        }
                    ]
                },
                "specialDiscount": {
                    "type": "cds.Decimal",
                    "precision": 10,
                    "scale": 2
                },
                "incomeStatement_documentID": {
                    "type": "cds.String",
                    "length": 100
                },
                "noOfKids": {
                    "type": "cds.Integer"
