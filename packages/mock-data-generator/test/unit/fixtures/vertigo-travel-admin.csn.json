                    "@Core.Immutable": true,
                    "@title": "{i18n>CreatedBy}",
                    "@readonly": true,
                    "@description": "{i18n>UserID.Description}",
                    "type": "User",
                    "length": 255
                },
                "modifiedAt": {
                    "@cds.on.insert": {
                        "=": "$now"
                    },
                    "@cds.on.update": {
                        "=": "$now"
                    },
                    "@UI.HiddenFilter": true,
                    "@UI.ExcludeFromNavigationContext": true,
                    "@title": "{i18n>ChangedAt}",
                    "@readonly": true,
                    "type": "cds.Timestamp"
                },
                "modifiedBy": {
                    "@cds.on.insert": {
                        "=": "$user"
                    },
                    "@cds.on.update": {
                        "=": "$user"
