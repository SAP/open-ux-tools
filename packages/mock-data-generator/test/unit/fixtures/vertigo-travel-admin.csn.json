                    "@description": "{i18n>UserID.Description}",
                    "type": "User",
                    "length": 255
                },
                "firstName": {
                    "type": "cds.String",
                    "length": 100
                },
                "lastName": {
                    "type": "cds.String",
                    "length": 100
                },
                "email": {
                    "type": "cds.String",
                    "length": 255
                },
                "dateOfBirth": {
                    "type": "cds.Date"
                },
                "isKid": {
                    "type": "cds.Boolean",
                    "default": {
                        "val": false
                    }
                },
                "parent": {
                    "type": "cds.Association",
                    "target": "AdminService.Travelers",
                    "keys": [
                        {
                            "ref": [
