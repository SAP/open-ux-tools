{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "moduleResolution": "bundler",
    "paths": {
      "testnamespace/alpv4captypescript/*": [
        "./webapp/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types"
    ]
  },
  "include": [
    "./webapp/**/*",
    "./node_modules/@sapui5/ts-types-esm/types/index.d.ts",
    "../../node_modules/@sapui5/ts-types-esm/types/index.d.ts"
  ]
}
