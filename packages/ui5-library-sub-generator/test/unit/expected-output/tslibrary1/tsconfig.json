{
  "compilerOptions": {
      "target": "es2022",
      "module": "es2022",
      "moduleResolution": "bundler",
      "skipLibCheck": true,
      "allowJs": true,
      "strict": true,
      "strictPropertyInitialization": false,
      "typeRoots": [
        "./node_modules/@types"
      ],
      "paths": {
          "com/sap/tslibrary1/*": [
              "./src/com/sap/tslibrary1/*"
          ]
      }
  },
  "include": [
      "./src/**/*",
      "./test/**/*",
      "./node_modules/@sapui5/ts-types-esm/types/index.d.ts"
  ]
}