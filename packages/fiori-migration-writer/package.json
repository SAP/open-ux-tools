{
    "name": "@sap-ux/fiori-migration-writer",
    "description": "Writer module for migrating Fiori applications from legacy WebIDE format to modern Fiori tools format.",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/SAP/open-ux-tools.git",
        "directory": "packages/fiori-migration-writer"
    },
    "bugs": {
        "url": "https://github.com/SAP/open-ux-tools/issues?q=is%3Aopen+is%3Aissue+label%3Abug+label%3Afiori-migration-writer"
    },
    "version": "1.0.1",
    "license": "Apache-2.0",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc --build",
        "watch": "tsc --watch",
        "clean": "rimraf --glob dist test/test-output coverage *.tsbuildinfo",
        "format": "prettier --write '**/*.{js,json,ts,yaml,yml}' --ignore-path ../../.prettierignore",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "test": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --ci --forceExit --detectOpenHandles --colors",
        "test-u": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --ci --forceExit --detectOpenHandles --colors -u",
        "link": "pnpm link --global",
        "unlink": "pnpm unlink --global"
    },
    "files": [
        "LICENSE",
        "dist",
        "templates",
        "!dist/*.map",
        "!dist/**/*.map"
    ],
    "dependencies": {
        "@sap-ux/adp-tooling": "workspace:*",
        "@sap-ux/axios-extension": "workspace:*",
        "@sap-ux/btp-utils": "workspace:*",
        "@sap-ux/i18n": "workspace:*",
        "@sap-ux/launch-config": "workspace:*",
        "@sap-ux/nodejs-utils": "workspace:*",
        "@sap-ux/project-access": "workspace:*",
        "@sap-ux/store": "workspace:*",
        "@sap-ux/ui5-application-writer": "workspace:*",
        "@sap-ux/ui5-config": "workspace:*",
        "@sap-ux/ui5-info": "workspace:*",
        "@ui5/manifest": "1.88.0",
        "ejs": "3.1.10",
        "fast-glob": "3.3.3",
        "fast-xml-parser": "5.8.0",
        "fs-extra": "11.3.6",
        "i18next": "26.3.6",
        "json-parse-even-better-errors": "2.3.1",
        "lodash": "4.18.1",
        "mem-fs": "2.1.0",
        "mem-fs-editor": "9.4.0",
        "read-pkg-up": "11.0.0",
        "semver": "7.8.5",
        "true-case-path": "2.2.1",
        "uuid": "11.1.1",
        "vscode-uri": "3.1.0",
        "yaml": "2.9.0"
    },
    "devDependencies": {
        "@sap-ux/eslint-plugin-fiori-tools": "workspace:*",
        "@types/ejs": "3.1.5",
        "@types/fs-extra": "11.0.4",
        "@types/lodash": "4.17.24",
        "@types/mem-fs": "1.1.2",
        "@types/mem-fs-editor": "7.0.1",
        "@types/semver": "7.7.1",
        "rimraf": "6.1.2"
    },
    "engines": {
        "node": ">=22.x"
    }
}
