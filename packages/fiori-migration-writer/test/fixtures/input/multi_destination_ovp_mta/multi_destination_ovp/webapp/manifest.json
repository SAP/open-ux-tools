{
	"_version": "1.7.0",
	"start_url": "start.html",
	"sap.app": {
		"id": "multi_destination_ovp.multi_destination_ovp",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "{{app_title}}",
		"description": "{{app_description}}",
		"ach": "aaa",
		"resources": "resources.json",
		"dataSources": {
			"SEPMRA_PROD_MAN": {
				"uri": "/sap/opu/odata/sap/SEPMRA_PROD_MAN/",
				"type": "OData",
				"settings": {
					"odataVersion": "2.0",
					"annotations": [
						"SEPMRA_PROD_MAN_ANNO_MDL",
						"annotation1"
					],
					"localUri": "localService/SEPMRA_PROD_MAN/metadata.xml"
				}
			},
			"SEPMRA_PROD_MAN_ANNO_MDL": {
				"uri": "DEMO_SYSTEM/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='SEPMRA_PROD_MAN_ANNO_MDL',Version='0001')/$value/",
				"type": "ODataAnnotation",
				"settings": {
					"localUri": "localService/SEPMRA_PROD_MAN/SEPMRA_PROD_MAN_ANNO_MDL.xml"
				}
			},
			"annotation1": {
				"type": "ODataAnnotation",
				"uri": "localService/SEPMRA_PROD_MAN/annotation1.xml",
				"settings": {
					"localUri": "localService/SEPMRA_PROD_MAN/annotation1.xml"
				}
			},
			"Northwind.svc": {
				"uri": "/northwind_v2/V2/Northwind/Northwind.svc/",
				"type": "OData",
				"settings": {
					"localUri": "localService/Northwind.svc/metadata.xml",
					"annotations": [
						"annotation2"
					]
				}
			},
			"annotation2": {
				"type": "ODataAnnotation",
				"uri": "localService/Northwind.svc/annotation2.xml",
				"settings": {
					"localUri": "localService/Northwind.svc/annotation2.xml"
				}
			}
		},
		"sourceTemplate": {
			"id": "OVP.cardtemplate",
			"version": "0.0.0"
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		},
		"supportedThemes": [
			"sap_fiori_3"
		]
	},
	"sap.ui5": {
		"dependencies": {
			"minUI5Version": "1.99.0",
			"libs": {
				"sap.ovp": {}
			}
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"uri": "i18n/i18n.properties"
			},
			"@i18n": {
				"preload": true,
				"type": "sap.ui.model.resource.ResourceModel",
				"uri": "i18n/i18n.properties"
			},
			"SEPMRA_PROD_MAN": {
				"dataSource": "SEPMRA_PROD_MAN",
				"settings": {
					"defaultCountMode": "Inline",
					"metadataUrlParams": {
						"sap-value-list": "none"
					}
				}
			},
			"northwind": {
				"type": "sap.ui.model.odata.v2.ODataModel",
				"settings": {
					"defaultOperationMode": "Server",
					"defaultBindingMode": "OneWay",
					"defaultCountMode": "Request"
				},
				"dataSource": "Northwind.svc",
				"preload": true
			}
		},
		"extends": {
			"extensions": {}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		}
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "analytical"
	},
	"sap.ovp": {
		"globalFilterModel": "SEPMRA_PROD_MAN",
		"containerLayout": "fixed",
		"enableLiveFilter": true,
		"smartVariantRequired": true,
		"cards": {
			"card00": {
				"model": "SEPMRA_PROD_MAN",
				"template": "sap.ovp.cards.list",
				"settings": {
					"title": "{{card00_title}}",
					"entitySet": "SEPMRA_C_PD_ContactPerson",
					"listType": "condensed",
					"listFlavor": "standard",
					"addODataSelect": false,
					"presentationAnnotationPath": "com.sap.vocabularies.UI.v1.PresentationVariant#byDefault5",
					"annotationPath": "com.sap.vocabularies.UI.v1.LineItem#ContactDetails"
				}
			},
			"card01": {
				"model": "northwind",
				"template": "sap.ovp.cards.list",
				"settings": {
					"title": "{{card01_title}}",
					"entitySet": "Products",
					"listType": "condensed",
					"listFlavor": "standard",
					"addODataSelect": false,
					"annotationPath": "com.sap.vocabularies.UI.v1.LineItem#northwind_table_product"
				}
			}
		}
	}
}