{
  "_version": "1.59.0",
  "sap.app": {
    "id": "com.example.with.reuse",
    "type": "application",
    "title": "Application with Reuse Libraries",
    "description": "Tests multiple reuse library types",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/REUSE_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "com.example.reuse.lib2": {
          "lazy": false
        }
      }
    },
    "componentUsages": {
      "reuseComponent1": {
        "name": "com.example.reuse.comp1",
        "settings": {},
        "componentData": {},
        "lazy": false
      }
    },
    "models": {
      "": {
        "dataSource": "mainService"
      }
    }
  }
}
