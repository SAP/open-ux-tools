{
  "_version": "1.59.0",
  "sap.app": {
    "id": "com.example.complex.services",
    "type": "application",
    "title": "Complex Service Configuration",
    "description": "Tests edge cases in service detection",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/MAIN_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "annotations": ["annotation1", "localAnnotation"]
        }
      },
      "annotation1": {
        "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='MAIN_ANNO',Version='0001')/$value/",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/MAIN_ANNO.xml"
        }
      },
      "localAnnotation": {
        "uri": "localService/annotation.xml",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/annotation.xml"
        }
      },
      "secondaryService": {
        "uri": "/sap/opu/odata4/sap/SECONDARY_SRV/default/sap/secondary/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      },
      "offlineService": {
        "uri": "/sap/opu/odata/sap/OFFLINE_SRV/",
        "type": "OData",
        "settings": {
          "localUri": "localService/offline.xml"
        }
      },
      "noSettingsService": {
        "uri": "/sap/opu/odata/sap/NO_SETTINGS/",
        "type": "OData"
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      },
      "secondary": {
        "dataSource": "secondaryService"
      },
      "offline": {
        "dataSource": "offlineService",
        "settings": {
          "offline": true
        }
      }
    }
  }
}
