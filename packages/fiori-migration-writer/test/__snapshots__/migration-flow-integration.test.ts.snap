object.link.label=\\\\u05E7\\\\u05D9\\\\u05E9\\\\u05D5\\\\u05E8 \\\\u05DC\\\\u05D0\\\\u05D5\\\\u05D1\\\\u05D9\\\\u05D9\\\\u05E7\\\\u05D8

#XFLD: No data text for History tab
view.ProcessLogs.noProcessLog=\\\\u05D4\\\\u05D9\\\\u05E1\\\\u05D8\\\\u05D5\\\\u05E8\\\\u05D9\\\\u05D9\\\\u05EA \\\\u05DE\\\\u05E9\\\\u05D9\\\\u05DE\\\\u05D4 \\\\u05DC\\\\u05D0 \\\\u05D6\\\\u05DE\\\\u05D9\\\\u05E0\\\\u05D4

#XFLD: Substituted info of Information Area
view.Workflow.Substituted=\\\\u05D1\\\\u05E9\\\\u05DD {0}

#XFLD: Overdue info of Information Area
view.Workflow.Overdue=\\\\u05EA\\\\u05D0\\\\u05E8\\\\u05D9\\\\u05DA \\\\u05D4\\\\u05D9\\\\u05E2\\\\u05D3 \\\\u05E2\\\\u05D1\\\\u05E8

#XTIT: Title of the Business Card for Employee
bc.title.employee=\\\\u05E2\\\\u05D5\\\\u05D1\\\\u05D3

#XTIT: Title of the Forward screen
view.Forward.title=\\\\u05D4\\\\u05E2\\\\u05D1\\\\u05E8

#XMSG: No data text for the forward dialog
view.Forward.noRecipients=\\\\u05DC\\\\u05D0 \\\\u05E0\\\\u05DE\\\\u05E6\\\\u05D0\\\\u05D5 \\\\u05E0\\\\u05DE\\\\u05E2\\\\u05E0\\\\u05D9\\\\u05DD. \\\\u05D4\\\\u05D6\\\\u05DF \\\\u05DE\\\\u05D5\\\\u05E0\\\\u05D7 \\\\u05D7\\\\u05D9\\\\u05E4\\\\u05D5\\\\u05E9.

#XMSG: No data text for the forward dialog
view.Forward.noRecipientsAfterSearch=\\\\u05DC\\\\u05D0 \\\\u05E0\\\\u05DE\\\\u05E6\\\\u05D0\\\\u05D5 \\\\u05E0\\\\u05DE\\\\u05E2\\\\u05E0\\\\u05D9\\\\u05DD

#XMSG: Placeholder in the master list while it is being updated
XMSG_LOADING=\\\\u05D8\\\\u05D5\\\\u05E2\\\\u05DF ...

#XMSG: A problem occurred while reading the data
DataManager.scenarioReadFailed=\\\\u05D0\\\\u05D9\\\\u05E8\\\\u05E2\\\\u05D4 \\\\u05D1\\\\u05E2\\\\u05D9\\\\u05D4 \\\\u05D1\\\\u05D6\\\\u05DE\\\\u05DF \\\\u05E7\\\\u05E8\\\\u05D9\\\\u05D0\\\\u05EA \\\\u05D4\\\\u05E0\\\\u05EA\\\\u05D5\\\\u05E0\\\\u05D9\\\\u05DD
#YMSG: A problem occurred while reading the data
DataManager.scenarioReadFailedDetail=\\\\u05D1\\\\u05D3\\\\u05D5\\\\u05E7 \\\\u05D0\\\\u05EA \\\\u05E4\\\\u05E8\\\\u05DE\\\\u05D8\\\\u05E8\\\\u05D9 \\\\u05DB\\\\u05EA\\\\u05D5\\\\u05D1\\\\u05EA \\\\u05D4-URL \\\\u05D5\\\\u05D0\\\\u05EA \\\\u05D4\\\\u05D2\\\\u05D3\\\\u05E8\\\\u05EA \\\\u05D4\\\\u05EA\\\\u05E8\\\\u05D7\\\\u05D9\\\\u05E9. \\\\u05DB\\\\u05D3\\\\u05D9 \\\\u05DC\\\\u05D1\\\\u05D3\\\\u05D5\\\\u05E7 \\\\u05D0\\\\u05EA \\\\u05D4\\\\u05D2\\\\u05D3\\\\u05E8\\\\u05EA \\\\u05D4\\\\u05EA\\\\u05E8\\\\u05D7\\\\u05D9\\\\u05E9, \\\\u05E2\\\\u05D1\\\\u05D5\\\\u05E8 \\\\u05D0\\\\u05DC \\\\u05D4\\\\u05EA\\\\u05D0\\\\u05DE\\\\u05D4 \\\\u05D0\\\\u05D9\\\\u05E9\\\\u05D9\\\\u05EA \\\\u05E2\\\\u05D1\\\\u05D5\\\\u05E8 SAP NetWeaver Gateway \\\\u05D5\\\\u05D1\\\\u05D7\\\\u05E8 SAP NetWeaver -> \\\\u05D0\\\\u05E4\\\\u05E9\\\\u05D5\\\\u05E8 \\\\u05E9\\\\u05D9\\\\u05E8\\\\u05D5\\\\u05EA Gateway -> \\\\u05EA\\\\u05D5\\\\u05DB\\\\u05DF -> \\\\u05E9\\\\u05D9\\\\u05E8\\\\u05D5\\\\u05EA Gateway \\\\u05E9\\\\u05DC \\\\u05DE\\\\u05E9\\\\u05D9\\\\u05DE\\\\u05D4 -> \\\\u05D4\\\\u05D2\\\\u05D3\\\\u05E8\\\\u05EA \\\\u05EA\\\\u05E8\\\\u05D7\\\\u05D9\\\\u05E9.
#XMSG: A problem occurred while communicating with the back end
DataManager.HTTPRequestFailed=\\\\u05E9\\\\u05D2\\\\u05D9\\\\u05D0\\\\u05EA \\\\u05DE\\\\u05E2\\\\u05E8\\\\u05DB\\\\u05EA. \\\\u05DC\\\\u05E7\\\\u05D1\\\\u05DC\\\\u05EA \\\\u05DE\\\\u05D9\\\\u05D3\\\\u05E2 \\\\u05E0\\\\u05D5\\\\u05E1\\\\u05E3, \\\\u05D1\\\\u05D3\\\\u05D5\\\\u05E7 \\\\u05D0\\\\u05EA \\\\u05D4\\\\u05E4\\\\u05E8\\\\u05D8\\\\u05D9\\\\u05DD \\\\u05D0\\\\u05D5 \\\\u05E6\\\\u05D5\\\\u05E8 \\\\u05E7\\\\u05E9\\\\u05E8 \\\\u05E2\\\\u05DD \\\\u05DE\\\\u05E0\\\\u05D4\\\\u05DC \\\\u05D4\\\\u05DE\\\\u05E2\\\\u05E8\\\\u05DB\\\\u05EA.
#XMSG: A problem occurred with the network connection
DataManager.connectionError=\\\\u05E9\\\\u05D2\\\\u05D9\\\\u05D0\\\\u05EA \\\\u05D7\\\\u05D9\\\\u05D1\\\\u05D5\\\\u05E8. \\\\u05D1\\\\u05D3\\\\u05D5\\\\u05E7 \\\\u05D0\\\\u05EA \\\\u05D4\\\\u05D2\\\\u05D3\\\\u05E8\\\\u05D5\\\\u05EA \\\\u05D4\\\\u05E8\\\\u05E9\\\\u05EA \\\\u05E9\\\\u05DC\\\\u05DA.
#XMSG: error message if loading the metadata fails on initial load 
DataManager.metadataFailed=\\\\u05D0\\\\u05D9\\\\u05E8\\\\u05E2\\\\u05D4 \\\\u05E9\\\\u05D2\\\\u05D9\\\\u05D0\\\\u05D4 \\\\u05D1\\\\u05E2\\\\u05EA \\\\u05D8\\\\u05E2\\\\u05D9\\\\u05E0\\\\u05EA \\\\u05E0\\\\u05EA\\\\u05D5\\\\u05E0\\\\u05D9\\\\u05DD; \\\\u05E6\\\\u05D5\\\\u05E8 \\\\u05E7\\\\u05E9\\\\u05E8 \\\\u05E2\\\\u05DD \\\\u05DE\\\\u05E0\\\\u05D4\\\\u05DC \\\\u05D4\\\\u05DE\\\\u05E2\\\\u05E8\\\\u05DB\\\\u05EA \\\\u05E9\\\\u05DC\\\\u05DA

#YMSG: Request was forwarded to <User>
dialog.success.forward=\\\\u05D4\\\\u05DE\\\\u05E9\\\\u05D9\\\\u05DE\\\\u05D4 \\\\u05D4\\\\u05D5\\\\u05E2\\\\u05D1\\\\u05E8\\\\u05D4 \\\\u05DC-{0}
#XMSG: Toast message if a generic request was reserved
dialog.success.reserve=\\\\u05DE\\\\u05E9\\\\u05D9\\\\u05DE\\\\u05D4 \\\\u05E9\\\\u05D5\\\\u05E8\\\\u05D9\\\\u05D9\\\\u05E0\\\\u05D4 \\\\u05D1\\\\u05D4\\\\u05E6\\\\u05DC\\\\u05D7\\\\u05D4
#XMSG: Toast message if a generic request was released
dialog.success.release=\\\\u05DE\\\\u05E9\\\\u05D9\\\\u05DE\\\\u05D4 \\\\u05E9\\\\u05D5\\\\u05D7\\\\u05E8\\\\u05E8\\\\u05D4 \\\\u05D1\\\\u05D4\\\\u05E6\\\\u05DC\\\\u05D7\\\\u05D4
#XMSG: Toast message if a generic request was approved
dialog.success.complete=\\\\u05DE\\\\u05E9\\\\u05D9\\\\u05DE\\\\u05D4 \\\\u05E2\\\\u05D5\\\\u05D1\\\\u05D3\\\\u05D4 \\\\u05D1\\\\u05D4\\\\u05E6\\\\u05DC\\\\u05D7\\\\u05D4
#XMSG: Toast message if a generic request was resubmitted
dialog.success.resubmit=\\\\u05D4\\\\u05DE\\\\u05E9\\\\u05D9\\\\u05DE\\\\u05D4 \\\\u05D4\\\\u05D5\\\\u05E9\\\\u05D4\\\\u05EA\\\\u05D4
#XMSG: Toast message if claim action has failed
dialog.error.claim=\\\\u05DC\\\\u05D0 \\\\u05E0\\\\u05D9\\\\u05EA\\\\u05DF \\\\u05DC\\\\u05E9\\\\u05E8\\\\u05D9\\\\u05D9\\\\u05DF \\\\u05DE\\\\u05E9\\\\u05D9\\\\u05DE\\\\u05D4. \\\\u05DC\\\\u05DE\\\\u05D9\\\\u05D3\\\\u05E2 \\\\u05E0\\\\u05D5\\\\u05E1\\\\u05E3, \\\\u05E8\\\\u05D0\\\\u05D4 \\\\u05D0\\\\u05EA \\\\u05D4\\\\u05E4\\\\u05E8\\\\u05D8\\\\u05D9\\\\u05DD
#XMSG: Toast message if release action has failed
dialog.error.release=\\\\u05DC\\\\u05D0 \\\\u05E0\\\\u05D9\\\\u05EA\\\\u05DF \\\\u05DC\\\\u05E9\\\\u05D7\\\\u05E8\\\\u05E8 \\\\u05DE\\\\u05E9\\\\u05D9\\\\u05DE\\\\u05D4. \\\\u05DC\\\\u05DE\\\\u05D9\\\\u05D3\\\\u05E2 \\\\u05E0\\\\u05D5\\\\u05E1\\\\u05E3, \\\\u05E8\\\\u05D0\\\\u05D4 \\\\u05D0\\\\u05EA \\\\u05D4\\\\u05E4\\\\u05E8\\\\u05D8\\\\u05D9\\\\u05DD
#XMSG: Toast message if custom action has failed
dialog.error.generic.action=\\\\u05DC\\\\u05D0 \\\\u05E0\\\\u05D9\\\\u05EA\\\\u05DF \\\\u05DC\\\\u05E2\\\\u05D1\\\\u05D3 \\\\u05DE\\\\u05E9\\\\u05D9\\\\u05DE\\\\u05D4. \\\\u05DC\\\\u05DE\\\\u05D9\\\\u05D3\\\\u05E2 \\\\u05E0\\\\u05D5\\\\u05E1\\\\u05E3, \\\\u05E8\\\\u05D0\\\\u05D4 \\\\u05D0\\\\u05EA \\\\u05D4\\\\u05E4\\\\u05E8\\\\u05D8\\\\u05D9\\\\u05DD
#XMSG: Toast message if Forward action fails
dialog.error.forward=\\\\u05DC\\\\u05D0 \\\\u05E0\\\\u05D9\\\\u05EA\\\\u05DF \\\\u05DC\\\\u05D4\\\\u05E2\\\\u05D1\\\\u05D9\\\\u05E8 \\\\u05DE\\\\u05E9\\\\u05D9\\\\u05DE\\\\u05D4.
#XMSG: Toast message if resubmit action has failed
