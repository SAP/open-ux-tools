  "pom.xml": Object {
    "contents": "<?xml version=\\"1.0\\" encoding=\\"UTF-8\\"?>
<project xmlns=\\"http://maven.apache.org/POM/4.0.0\\" xmlns:xsi=\\"http://www.w3.org/2001/XMLSchema-instance\\" xsi:schemaLocation=\\"http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd\\">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.sap.fiori</groupId>
	<artifactId>i2d.qm.defect.records1</artifactId>
	<version>11.17.0-SNAPSHOT</version>
	<packaging>war</packaging>
	<name>i2d.qm.defect.records1</name>
	<parent>
		<groupId>com.sap.fiori</groupId>
		<artifactId>fnf-parent-pom</artifactId>
		<version>1.32.0-SNAPSHOT</version>
	</parent>
	<dependencies>
		<dependency>
			<groupId>com.sap.suite.ui.generic.template</groupId>
			<artifactId>sap.suite.ui.generic.template</artifactId>
		</dependency>
		<dependency>   
    		<groupId>com.sap.fiori</groupId>   
    		<artifactId>se.mi.plm.lib.attachmentservice</artifactId>   
    		<version>[11.17.0-SNAPSHOT,11.18.0-SNAPSHOT)</version>  
		</dependency>
		<dependency>
			<groupId>com.sap.suite.ui.generic.template</groupId>
			<artifactId>sap.suite.ui.generic.template</artifactId>
			<classifier>testresources</classifier>
		</dependency>
		<dependency> 
			<groupId>com.sap.fiori</groupId>
			<artifactId>sample.featuretoggle.lib</artifactId>
			<version>[11.17.0-SNAPSHOT,11.18.0-SNAPSHOT)</version>
		</dependency>
		<dependency> 
			<groupId>com.sap.fiori</groupId>
			<artifactId>nw.core.changedocs.lib.reuse</artifactId>
			<version>[1.22.0-SNAPSHOT, 1.23.0-SNAPSHOT)</version>
		</dependency>
		<dependency>
			<groupId>com.sap.fiori</groupId>
			<artifactId>ssuite.fnd.om.outputcontrol</artifactId>
			<version>[11.17.0-SNAPSHOT,11.18.0-SNAPSHOT)</version>
		</dependency>
	</dependencies>
	<!-- 
        YOU NEED TO SPECIFY the translationDeveloper and the translationCollection 
        For Fiori On-Premise apps: Use FIORI_ as the prefix followed by your
        app name. Please use a meaningful short version of the app name and 
        not the GIT project name.The string must not exceed 32 character
    -->
	<build>
		<plugins>
			<plugin>
				<groupId>com.sap.ldi</groupId>
				<artifactId>translation-plugin</artifactId>
				<configuration>
					<translationDomain>QM</translationDomain>
					<translationDeveloper>D028304</translationDeveloper>
					<translationCollection>SSUITE_QDefectRecord</translationCollection>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>",
    "state": "modified",
  },
  "ui5-local.yaml": Object {
    "contents": "specVersion: \\"4.0\\"
metadata:
  name: demo.qm.defect.records
type: application
framework:
  name: SAPUI5
  version: snapshot
  libraries:
    - name: sap.collaboration
    - name: sap.f
    - name: sap.m
    - name: sap.suite.ui.generic.template
    - name: sap.ui.comp
    - name: sap.ui.core
    - name: sap.ui.generic.app
    - name: sap.ui.layout
    - name: sap.ushell
    - name: sap.ui.table
    - name: themelib_sap_bluecrystal
    - name: themelib_sap_horizon
server:
  customMiddleware:
    - name: fiori-tools-proxy
      afterMiddleware: compression
      configuration:
        ignoreCertErrors: false
        backend:
          - path: /sap
            url: https://backend.example.com:44300
            client: \\"928\\"
            destination: UYTCLNT928
    - name: fiori-tools-appreload
      afterMiddleware: compression
      configuration:
        port: 35729
        path: webapp
        delay: 300
    - name: fiori-tools-preview
      afterMiddleware: fiori-tools-appreload
      configuration:
        component: demo.qm.defect.records
        ui5Theme: sap_horizon
",
    "state": "modified",
  },
  "ui5.yaml": Object {
    "contents": "specVersion: \\"4.0\\"
metadata:
  name: demo.qm.defect.records
type: application
framework:
  name: SAPUI5
  version: snapshot
  libraries:
    - name: sap.collaboration
    - name: sap.f
    - name: sap.m
    - name: sap.suite.ui.generic.template
    - name: sap.ui.comp
    - name: sap.ui.core
    - name: sap.ui.generic.app
    - name: sap.ui.layout
    - name: sap.ushell
    - name: sap.ui.table
    - name: themelib_sap_bluecrystal
    - name: themelib_sap_horizon
server:
  customMiddleware:
    - name: fiori-tools-proxy
      afterMiddleware: compression
      configuration:
        ignoreCertErrors: false
        backend:
          - path: /sap
            url: https://backend.example.com:44300
            client: \\"928\\"
            destination: UYTCLNT928
        ui5:
          path:
            - /resources
            - /test-resources
          url: https://ui5.sap.com
    - name: fiori-tools-appreload
      afterMiddleware: compression
      configuration:
        port: 35729
        path: webapp
        delay: 300
    - name: fiori-tools-preview
      afterMiddleware: fiori-tools-appreload
      configuration:
        component: demo.qm.defect.records
        ui5Theme: sap_horizon
",
    "state": "modified",
  },
