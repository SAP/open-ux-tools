view.CreateComment.noComments=\\\\u05D0\\\\u05D9\\\\u05DF \\\\u05D4\\\\u05E2\\\\u05E8\\\\u05D5\\\\u05EA

#XFLD: No data text for comment list
view.Attachments.noAttachments=\\\\u05DC\\\\u05DC\\\\u05D0 \\\\u05E7\\\\u05D1\\\\u05E6\\\\u05D9\\\\u05DD \\\\u05DE\\\\u05E6\\\\u05D5\\\\u05E8\\\\u05E4\\\\u05D9\\\\u05DD

#XFLD: No data text for Object Link list
view.ObjectLinks.noObjectLink=\\\\u05D0\\\\u05D9\\\\u05DF \\\\u05D0\\\\u05D5\\\\u05D1\\\\u05D9\\\\u05D9\\\\u05E7\\\\u05D8\\\\u05D9\\\\u05DD \\\\u05E7\\\\u05E9\\\\u05D5\\\\u05E8\\\\u05D9\\\\u05DD

