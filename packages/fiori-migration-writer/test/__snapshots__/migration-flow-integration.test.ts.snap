NO_DATA=NO DATA
#XBUT: Setting button in setting header
SETTINGS=Set Controlling Area
#XMSG: when customer search first time and without setting Controlling Area .
MSG_SET_KOKRS=Please maintain the default Controlling Area setting.
#XMSG: when setting Controlling Area SAVED .
KOKRS_SAVE_OK=Controlling Area has been set.
#XMSG: Please select one item
MSG_SELECT_SINGLE_ITEM=Please select one item
#XMSG: No authorization to edit message
MSG_NO_AUTH_EDIT=No authorization for function: Change Master Data
#XMSG: No authorization to create message
MSG_NO_AUTH_CREATE=No authorization for function: Create Master Data
#XMSG: Not set a controlling area
MSG_CONTROLLINGAREA_NOTSELECT=You have not set a controlling area.

#XMSG: Not set controlling area detail message
MSG_CONTROLLINGAREA_NOTSELECT_DETAIL=You must first set a controlling area: Enter the Me area in the top-left corner of the homepage. Click \\"Settings\\" and then \\"Default Values\\" and enter a value in the \\"Controlling Area\\" field.


#@################COLUMN ##############################

