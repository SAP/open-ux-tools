  "webapp/test/qunit/tools/jsunit_to_junit.xsl": Object {
    "contents": "<?xml version=\\"1.0\\"?>
<xsl:stylesheet version=\\"1.0\\"  xmlns:xsl=\\"http://www.w3.org/1999/XSL/Transform\\">

	<xsl:output method=\\"xml\\" indent=\\"yes\\" encoding=\\"UTF-8\\"/>
	<xsl:template match=\\"browserResult\\">
		<!--  Get browser name including browser version -->	  
		<xsl:variable name=\\"browserDisplayName\\" select=\\"browser/displayName\\" />
		<xsl:variable name=\\"_browser\\">
			<xsl:choose>
				<xsl:when test=\\"contains($browserDisplayName,'Chrome')\\">
					<xsl:value-of select=\\"substring-before(substring-after($browserDisplayName,'Google\\\\'),'\\\\Application')\\" />
				</xsl:when>
				<xsl:otherwise>
					<xsl:value-of select=\\"$browserDisplayName\\" />
				</xsl:otherwise>
			</xsl:choose>
		</xsl:variable>		
		<xsl:variable name=\\"userAgent\\" select=\\"properties/property[@name='userAgent']/@value\\" />
		<xsl:variable name=\\"browserVersion\\">
			<xsl:choose>
				<xsl:when test=\\"contains($_browser,'Internet Explorer')\\">
					<xsl:variable name=\\"subString\\" select=\\"substring-after($userAgent,'MSIE ')\\" />
					<xsl:value-of select=\\"substring($subString,1,1)\\" />
				</xsl:when>
				<xsl:when test=\\"contains($_browser,'Firefox')\\">
					<xsl:variable name=\\"subString\\" select=\\"substring-after($userAgent,'Firefox/')\\" />
					<xsl:choose>
						<xsl:when test=\\"contains($subString,'3.6')\\">
							<xsl:value-of select=\\"substring($subString,1,3)\\" />
						</xsl:when>
						<xsl:otherwise>
							<xsl:value-of select=\\"substring($subString,1,4)\\" />
						</xsl:otherwise>
					</xsl:choose>
				</xsl:when>
				<xsl:when test=\\"contains($_browser,'Safari')\\">
					<xsl:variable name=\\"subString\\" select=\\"substring-after($userAgent,'Version/')\\" />
					<xsl:value-of select=\\"substring($subString,1,3)\\" />
				</xsl:when>
				<xsl:when test=\\"contains($_browser,'Chrome')\\">
					<xsl:variable name=\\"subString\\" select=\\"substring-after($userAgent,'Chrome/')\\" />
					<xsl:value-of select=\\"substring($subString,1,4)\\" />
				</xsl:when>
				<xsl:otherwise>
					<xsl:value-of select=\\"'unknown'\\" />
				</xsl:otherwise>
			</xsl:choose>
		</xsl:variable>
		<xsl:variable name=\\"browser\\">
			<xsl:choose>
				<xsl:when test=\\"$browserVersion != 'unknown'\\">
					<xsl:value-of select=\\"normalize-space(concat($_browser,' ',$browserVersion))\\" />
				</xsl:when>
				<xsl:otherwise>
					<xsl:value-of select=\\"normalize-space($_browser)\\" />
				</xsl:otherwise>
			</xsl:choose>
		</xsl:variable>

		<xsl:variable name=\\"numberOfTests\\" select=\\"count(descendant::testCaseResult)\\" />
		<xsl:variable name=\\"numberOfErrors\\" select=\\"count(descendant::error)\\" />
		<xsl:variable name=\\"numberOfFailures\\" select=\\"count(descendant::failure)\\" />
		<xsl:variable name=\\"hostName\\" select=\\"properties/property[@name = 'remoteAddress']/@value\\" />
		<xsl:variable name=\\"testSuiteName\\" select=\\"properties/property[@name = 'testPage']/@value\\" />
		<xsl:variable name=\\"totalTime\\" select='format-number(sum(descendant::testCaseResult/@time), \\"#.###\\")' />
		
		<xsl:choose>
			<xsl:when test=\\"@type != 'SUCCESS' and @type != 'ERROR' and @type != 'FAILURE'\\">
			
				<!-- report errors -->
				<testsuite errors=\\"1\\" failures=\\"0\\" hostname=\\"{$hostName}\\" name=\\"{$browser}\\" tests=\\"1\\" time=\\"{$totalTime}\\">
					<testcase classname=\\"{$browser}\\" name=\\"error\\" time=\\"{@time}\\">
						<error message=\\"{@type}\\" type=\\"{@type}\\"><xsl:value-of select=\\"@type\\"></xsl:value-of></error>
					</testcase>
				</testsuite>
			
			</xsl:when>
			<xsl:otherwise>
			
				<!-- <testsuites> -->
					<testsuite errors=\\"{$numberOfErrors}\\" failures=\\"{$numberOfFailures}\\" hostname=\\"{$hostName}\\" name=\\"{$browser}.{$testSuiteName}\\" tests=\\"{$numberOfTests}\\" time=\\"{$totalTime}\\">
						<xsl:copy-of select=\\"properties\\" /> <!-- copy all properties -->
						<xsl:for-each select=\\"testCaseResults/testCaseResult\\">
						  <xsl:variable name=\\"classname\\">
							  <xsl:call-template name=\\"get-classname\\">
								  <xsl:with-param name=\\"testname\\" select=\\"substring-before(@name,'.html:')\\"/>
							  </xsl:call-template>
						  </xsl:variable>
						  <testcase classname=\\"{$browser}.{$classname}\\" name=\\"{substring-after(@name,'.html:')}\\" time=\\"{@time}\\">
							   <xsl:copy-of select=\\"*\\" /> <!-- copy all failures and errors -->
						  </testcase>
						</xsl:for-each>
					</testsuite>
				 <!-- </testsuites> -->
		
			</xsl:otherwise>
		</xsl:choose>

	</xsl:template>

	<!-- recursively strips slashes from the beginning until none are left -->
	<xsl:template name=\\"get-classname\\">
		<xsl:param name=\\"testname\\" />
		<xsl:choose>
			<xsl:when test=\\"contains($testname, '/')\\">
				<xsl:call-template name=\\"get-classname\\">
					<xsl:with-param name=\\"testname\\" select=\\"substring-after($testname, '/')\\" />
				</xsl:call-template>
			</xsl:when>
			<xsl:otherwise>
				<xsl:value-of select=\\"$testname\\" />
			</xsl:otherwise>
		</xsl:choose>
	</xsl:template>
	
</xsl:stylesheet>",
    "state": "modified",
  },
  "webapp/test/qunit/unit/GlobalTest.js": Object {
    "contents": "/*eslint-disable*/
module(\\"GlobalTest\\", {
	setup: function() {
	},
	teardown: function() {
	}
});

test(\\"Global: fin.ap.line may not appear in source files\\", function() {
	var checkFile = function(sFilePath) {
		var oRequest = jQuery.sap.sjax({
			url: jQuery.sap.getModulePath(\\"fin.ar.lineitems.display\\") + \\"/\\" + sFilePath,
			dataType: \\"text\\"
		});
		ok(oRequest.success, \\"Data of file \\" + sFilePath + \\" needs to be available\\");
		ok(typeof oRequest.data === 'string', \\"Data of file \\" + sFilePath + \\" needs to be retrieved\\");

		var regexp = /fin\\\\.ap\\\\.line/ig;
		ok(!regexp.test(oRequest.data), \\"the String 'fin.ap.line' must not be used in \\" + sFilePath);
	};

	var aFiles = [
		\\"view/S1.view.xml\\", \\"view/S1.controller.js\\", \\"App.controller.js\\", \\"App.view.xml\\", \\"Component.js\\"
	];

	for (var i = 0; i < aFiles.length; i++) {
		checkFile(aFiles[i]);
	}
});",
    "state": "modified",
  },
  "webapp/test/qunit/unit/S1controllerEnvTest.js": Object {
    "contents": "/*eslint-disable*/
jQuery.sap.require({
	modName: \\"fin.ar.lineitems.display.view.S1\\",
	type: \\"controller\\"
});

module(\\"S1controllerEnvTest which taints the environment\\", {
	setup: function() {
		startApp(false);
		var controller = getRunningApplicationView().getController();
		controller.getOwnerComponent().oComponentData = {};
	},
	teardown: function() {
		tearDownStubs();
		stopApp(false);

		sap.qunit.message.mocking.ensureCatchMessagesDisabled();
	}
});

test(\\"onInit\\", function() {

	var oController = getRunningApplicationView().getController();
	var bInitFinished = false;

	var oStubInitDeferred = sinon.stub(oController.initDeferred, \\"resolve\\", function() {
		bInitFinished = true;
	});
	rememberStubToTearDown(oStubInitDeferred);

	oController.onInit();

	// just check some important objects and variables to be initialized
	assert.ok(oController.oView !== undefined, \\"View initialized\\");
	assert.ok(oController.oModel !== undefined, \\"Model initialized\\");
	assert.ok(oController.oTable !== undefined, \\"Table initialized\\");
	assert.ok(oController.oSmartFilterBar !== undefined, \\"FilterBar initialized\\");
	assert.ok(oController.oRouter !== undefined, \\"Router initialized\\");
	assert.ok(oController.oi18n !== undefined, \\"i18n initialized\\");
	assert.ok(oController.oi18nLib !== undefined, \\"i18nLib initialized\\");
	assert.ok(bInitFinished === true, \\"initDeferred resolved\\");
});

test(\\"onBeforePopoverOpens\\", function() {
	var oController = getRunningApplicationView().getController();
	var bEventEqual = false;
	var bPathEqual = false;
	
	var oMyEvent = {
			getParameters: function() {
				return {
					semanticAttributes: {Customer: \\"C0001\\"}
				};
			}
		};
	
	var oStubCreatePopoverContent = sinon.stub(oController, \\"createPopoverContent\\", function(oEvent, sAddressDataPath){
		bEventEqual = oMyEvent === oEvent;
		bPathEqual =  sAddressDataPath === \\"/Customers(CustomerId='C0001')\\";
	});
	rememberStubToTearDown(oStubCreatePopoverContent);

	oController.onBeforePopoverOpens(oMyEvent);
	assert.ok(bEventEqual, \\"Event was passed over correctly\\");
	assert.ok(bPathEqual, \\"Path to Supplier composed correctly\\");
});",
    "state": "modified",
  },
  "webapp/test/qunit/unit/S1controllerTest.js": Object {
    "contents": "/*eslint-disable*/
module(\\"S1controllerTest\\", {
	setup: function () {
		// to be filled if needed
	},
	teardown: function () {
		// to be filled if needed
	}
});

test(\\"all ids in S1.view.xml need be in the fin.ar. namespace\\", function () {
	/*
	 * Background: All ids are globally (accross all running apps within the same browser window. If we use ids which are not within our namespace, we
	 * may pollute the namespace of other apps (or the framework) and thus cause a clash.
	 */

	var oRequest = jQuery.sap.sjax({
		url: jQuery.sap.getModulePath(\\"fin.ar.lineitems.display\\") + \\"/view/S1.view.xml\\",
		dataType: \\"xml\\"
	});
	var doc;

	ok(oRequest.success, \\"XML file for S1.view needs to be retrieved\\");
	equal(typeof oRequest.data, 'object', \\"Data retrieved needs to be an object\\");

	doc = oRequest.data;

	var fNamespaceResolver = function (sPrefix) {
		if (sPrefix === \\"table\\") {
			return \\"sap.ui.table\\";
		}

		QUnit.assert.ok(false, \\"Unknown prefix requested: \\" + sPrefix);
		return undefined; // unknown prefix
	};

	var oCCNodes = doc.evaluate(\\"//@id\\", doc, fNamespaceResolver, XPathResult.ANY_TYPE, null);

	var oNode = oCCNodes.iterateNext(); // get the first node

	while (oNode) {
		ok(/^fin\\\\.ar\\\\./.test(oNode.value), \\"id '\\" + oNode.value + \\"' needs to be in the fin.ar.* namespace\\");

		oNode = oCCNodes.iterateNext(); // get the next node
	}
})

test(
	\\"CrossNavigation outbound to ApplicationJob properly configured in manifest.json used by fin.arp.lib.lineitems.NavigationController.navigateToJobDetails() \\",
	function () {
		/*
		 * to be able to navigate to the FinanceApplicationJob fin.arp.lib.lineitems.NavigationController.navigateToJobDetails()
		 * is relying on proper configuration of the \\"sap.app\\".crossNavigation.outbounds.scheduleJobs object in manifest.json
		 */
		var oRequest = jQuery.sap.sjax({
			url: jQuery.sap.getModulePath(\\"fin.ar.lineitems.display\\") + \\"/manifest.json\\",
			dataType: \\"json\\"
		});
		ok(oRequest.success, \\"manifest.json retrieved\\");
		var manifest = oRequest.data;
		var oScheduleJobsConfig = manifest[\\"sap.app\\"].crossNavigation.outbounds.scheduleJobs;
		ok(oScheduleJobsConfig.semanticObject === \\"FinanceApplicationJob\\",
			\\"crossNavigation.outbounds.scheduleJobs.semanticObject configured fin.arp.lib.lineitems.NavigationController.navigateToJobDetails() is relying on\\"
		);
		ok(oScheduleJobsConfig.action === \\"scheduleAccReceivableJobs\\",
			\\"crossNavigation.outbounds.scheduleJobs.action configured fin.arp.lib.lineitems.NavigationController.navigateToJobDetails() is relying on\\"
		);
		ok(oScheduleJobsConfig.parameters.JobCatalogEntryName.value.value === \\"SAP_FIN_AR_ITEM_MASS_CHANGE\\",
			\\"crossNavigation.outbounds.scheduleJobs.parameters.JobCatalogEntryName.value.value configured fin.arp.lib.lineitems.NavigationController.navigateToJobDetails() is relying on\\"
		)
	});",
    "state": "modified",
  },
  "webapp/test/qunit/unit/model/MockServer.js": Object {
    "contents": "jQuery.sap.declare(\\"fin.ar.lineitems.display.test.unit.model.MockServer\\");
jQuery.sap.require(\\"sap.ui.core.util.MockServer\\");

fin.ar.lineitems.display.test.unit.model.MockServer = {
	init: function(context) {
		// recommendation from Gal Roter (Wed 24.06.2015 11:59 GMT+1) to use an own mockserver to handle the lrep requests
		var oMockServer = new sap.ui.core.util.MockServer({
			rootUri: \\"/sap/bc/lrep/\\",
			requests: [
				{
					method: \\"HEAD\\",
					path: /actions\\\\/getcsrftoken\\\\/.*/,
					response: function(oXhr) {
						oXhr.respond(204);
						return true;
					}
				}, {
					method: \\"GET\\",
					path: /flex\\\\/data\\\\/.*/,
					response: function(oXhr) {
						oXhr.respond(200, {
							\\"Content-Type\\": \\"application/json;charset=utf-8\\"
						}, JSON.stringify({
							\\"changes\\": [],
							\\"settings\\": {
								\\"isKeyUser\\": true,
								\\"isAtoAvailable\\": true,
								\\"isAtoEnabled\\": false,
								\\"isProductiveSystem\\": false
							}
						}));
						return true;
					}
				}
			]
		});
		oMockServer.start();
		
		var oMockServerOData = new sap.ui.core.util.MockServer({
			rootUri: \\"/sap/opu/odata/sap/FAR_CUSTOMER_LINE_ITEMS/\\"
		});
		
		var sModelBaseUrl = jQuery.sap.getModulePath(\\"fin.ar.lineitems.display\\") + \\"/model\\";
		
		oMockServerOData.simulate(sModelBaseUrl + \\"/metadata.xml\\", {
			bGenerateMissingMockData: false,
			sMockdataBaseUrl: sModelBaseUrl
		});
		oMockServerOData.start();
	}
};",
    "state": "modified",
  },
  "webapp/version.json": Object {
    "contents": "{ \\"application\\": \\"\${project.artifactId}\\",
  \\"version\\": \\"\${project.version}\\",
  \\"buildNumber\\": \\"\${env.BUILD_NUMBER}\\",
  \\"buildId\\": \\"\${env.BUILD_ID}\\",
  \\"branch\\": \\"\${env.GIT_BRANCH}\\",
  \\"revision\\": \\"\${env.GIT_COMMIT}\\",
  \\"GitURL\\": \\"\${env.GIT_URL}\\"
}",
    "state": "modified",
  },
  "webapp/view/S1.controller.js": Object {
    "contents": "/*
 * ! \${copyright}
 */

sap.ui.define([
	\\"sap/fin/arp/lib/lineitems/controller/AbstractController\\",
	\\"sap/m/MessageBox\\"],
	function(AbstractController, MessageBox){
		\\"use strict\\";

		var S1Controller = sap.fin.arp.lib.lineitems.controller.AbstractController.extend(
			\\"fin.ar.lineitems.display.view.S1\\", {
			/**
			 * @memberOf fin.ar.lineitems.display.view.S1.controller
			 */

			constructor: function() {
				AbstractController.apply(this, arguments);
				this.sLocalContainerKey = \\"fin.ar.lineitems\\";
				this.sPrefix = \\"fin.ar.lineitems.display\\";
				this.sIconPath = \\"sap-icon://Fiori5/F0711\\";
				this.sOwnSemanticObject = \\"Customer\\";
				this.sCustomerVendorItemTypeKey = \\"V\\";
				this.initDeferred = jQuery.Deferred();
			},

			onInit: function() {
				AbstractController.prototype.onInit.apply(this, arguments);
				this.setExtendedFooterOptions();
			},
			
			onExit: function() {
				this.cleanUpNavController();
			},

			onInitSmartFilterBar: function() {
				var that = this;
				this.initDeferred.done(function(){
					AbstractController.prototype.onInitSmartFilterBar.apply(that, arguments);
					that.checkForNavigation();
				});
			},

			onNavTargetsObtained: function(oEvent) {
				this.openPopover(oEvent, this.oi18n.getText(\\"POPOVER_CLI_LINK\\"));
			},

			onBeforePopoverOpens: function(oEvent) {
				// This event handler is called, when a smart link is clicked.
				var sCustomer = oEvent.getParameters().semanticAttributes.Customer;
				var sAddressDataPath = \\"/Customers(CustomerId='\\" + encodeURIComponent(sCustomer) + \\"')\\";
				this.createPopoverContent(oEvent, sAddressDataPath);
			},

			onButtonPressedSendCorrespondence: function() {
				if (this.aSelectedKeys.length <= this.MAX_NUMBER_OF_ITEMS) {
					this.sendCorrespondence(\\"D\\", \\"Customer\\");
				} else {
					MessageBox.information(this.oi18nLib.getText(\\"NO_ITEM_CHANGE_LIMIT\\", this.MAX_NUMBER_OF_ITEMS));
				}
			},
			
			onBeforeRendering: function() {
				// The \\"onBeforeRendering\\" event handler must be defined in the S1.controller, not in the AbstractController.
				// The \\"this\\" variable has a different context, if onBeforeRendering is directly defined in the AbstractController.
				this.onBeforeViewRendering();
			},
			
			setExtendedFooterOptions: function(){
				/**
				 * @ControllerHook Allows modification of the footer area. Implement this hook if you wish to add new buttons to the footer bar. 
				 * The hook is called onInit when the footer options are defined.
				 * Example of adding a button in extHookModifyFooterOptions:
				 * 
				 * extHookModifyFooterOptions: function(oOptions) {
				 *	var fnOnBtnPressed = function() { 
				 *							this.oSmartFilterBar.search();
				 *						};
				 *
				 *	var fnCalcEnabled = function(oController) {
				 *							return oController.aSelectedKeys.length >= 1;
				 *						}; //optional function which returns true or false
				 *
				 *	var myButton = { sId: \\"myButton\\", 
				 *					sI18nBtnTxt: \\"My Button\\",
				 *					bDisabled: false,
				 *					onBtnPressed: jQuery.proxy(fnOnBtnPressed,this),
				 *					calcEnabled: fnCalcEnabled
				 *					};
				 *
				 *	oOptions.buttonList.push(myButton);
				 *	return oOptions;
				 * }
				 * 
				 * @callback sap.ca.scfld.md.controller.BaseFullscreenController~extHookModifyFooterOptions
				 * @param {Object} oOptions: Object containing the buttonList array
				 * @return {Object} oOptions: modified footer options in the same format as the parameter. Note that the return parameter must contain the complete object
				 */
				 
				if (this.extHookModifyFooterOptions) {
					var oOptions = this.extHookModifyFooterOptions({buttonList: []});
					if(oOptions.buttonList && oOptions.buttonList.length > 0){
						this.addExtensionButtons(oOptions);
					}
				}
			}
		});
		
		return S1Controller;
	}, /* bExport= */true);",
    "state": "modified",
  },
  "webapp/view/S1.view.xml": Object {
    "contents": "<mvc:View 
	controllerName=\\"fin.ar.lineitems.display.view.S1\\"
	xmlns=\\"sap.m\\" 
	xmlns:core=\\"sap.ui.core\\"  
	xmlns:customData=\\"http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1\\"
	xmlns:f=\\"sap.f\\" 
	xmlns:footerbar=\\"sap.ushell.ui.footerbar\\"
	xmlns:html=\\"http://www.w3.org/1999/xhtml\\" 
	xmlns:l=\\"sap.ui.layout\\" 
	xmlns:mvc=\\"sap.ui.core.mvc\\" 
	xmlns:smartfilterbar=\\"sap.ui.comp.smartfilterbar\\" 
	xmlns:smarttable=\\"sap.ui.comp.smarttable\\"
	xmlns:smartlink=\\"sap.ui.comp.navpopover\\" 
	xmlns:table=\\"sap.ui.table\\"
	xmlns:unified=\\"sap.ui.unified\\" 
	xmlns:variants=\\"sap.ui.comp.smartvariants\\"
	xmlns:plugins=\\"sap.ui.table.plugins\\">

	<f:DynamicPage 
		id=\\"fin.ar.lineitems.display.Page\\" busy=\\"{appView>/busy}\\" busyIndicatorDelay=\\"400\\" 
		headerExpanded=\\"{page>/headerExpanded}\\" preserveHeaderStateOnScroll=\\"false\\" fitContent=\\"true\\"
		showFooter=\\"false\\" >
		<f:title>
			<f:DynamicPageTitle id=\\"fin.ar.lineitems.display.PageTitle\\">
				<f:heading>
					<variants:SmartVariantManagement id=\\"fin.ar.lineitems.display.PageVariant\\"
						showExecuteOnSelection=\\"true\\" showShare=\\"true\\"/>
				</f:heading>
				<f:actions>
					<ToolbarSpacer id=\\"fin.ar.lineitems.display.Actions.ToolbarSpacer\\"/>
					<Button id=\\"fin.ar.lineitems.display.JobLogButton\\" text=\\"{i18nLib>VIEW_JOBS_BUTTON}\\" type=\\"Transparent\\" press=\\"onJobLogButtonPressed\\"/>  
					<Button id=\\"fin.ar.lineitems.display.ToggleHeaderButton\\" text=\\"{path:'page>/headerExpanded', formatter:'.formatToggleButtonText'}\\" 
						type=\\"Transparent\\" press=\\"onToggleHeaderPressed\\"/>
					<Button id=\\"fin.ar.lineitems.display.ShareButton\\" icon=\\"sap-icon://action\\" tooltip=\\"{i18nLib>SHARE_BUTTON}\\" type=\\"Transparent\\" press=\\"onShareButtonPressed\\"/>
				</f:actions>
				<f:snappedContent>
					<Text id=\\"fin.ar.lineitems.display.FilterText\\" wrapping=\\"false\\"></Text>
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader id=\\"fin.ar.lineitems.display.PageHeader\\" pinnable=\\"false\\">
				<f:content>
					<!-- Invisible text needed for screenreader -->
					<core:InvisibleText id=\\"fin.ar.lineitems.display.InvisibleText.ClearingStatus\\" text=\\"{i18nLib>LABEL_CLEARINGSTATUS}\\" />
					<core:InvisibleText id=\\"fin.ar.lineitems.display.InvisibleText.AccountingDocumentType\\" text=\\"{i18nLib>LABEL_ACCDOCTYPE}\\" />
					<smartfilterbar:SmartFilterBar
						id=\\"fin.ar.lineitems.display.SmartFilterBar\\" entitySet=\\"Items\\"
						search=\\"onSearchButtonPressed\\" reset=\\"onReset\\" initialise=\\"onInitSmartFilterBar\\"
						beforeVariantSave=\\"onBeforeVariantSave\\" afterVariantLoad=\\"onAfterVariantLoad\\"
						persistencyKey=\\"fin.ar.lineitems.display.view.S1\\"
						smartVariant=\\"fin.ar.lineitems.display.PageVariant\\" useToolbar=\\"false\\" assignedFiltersChanged=\\"onAssignedFiltersChanged\\">
						<smartfilterbar:customData>
							<core:CustomData id=\\"fin.ar.lineitems.display.sfb.cd.defaultDropDownDisplayBehaviour\\"
								key=\\"defaultDropDownDisplayBehaviour\\"
								value=\\"descriptionOnly\\" />
							<core:CustomData id=\\"fin.ar.lineitems.display.sfb.cd.defaultTokenDisplayBehaviour\\"
							    key=\\"defaultTokenDisplayBehaviour\\"
								value=\\"idAndDescription\\" />
							<core:CustomData id=\\"fin.ar.lineitems.display.sfb.cd.dateFormatSettings\\" key=\\"dateFormatSettings\\"
								value='\\\\{\\"UTC\\":true,\\"style\\":\\"short\\"\\\\}' />
						</smartfilterbar:customData>
						<smartfilterbar:layoutData>
							<FlexItemData id=\\"fin.ar.lineitems.display.sfb.FlexItemData\\" shrinkFactor=\\"0\\" />
						</smartfilterbar:layoutData>
						<smartfilterbar:controlConfiguration>
							<smartfilterbar:ControlConfiguration
								id=\\"fin.ar.lineitems.display.ValueHelpCustomer\\" key=\\"Customer\\"
								index=\\"0\\" groupId=\\"_BASIC\\" />
							<smartfilterbar:ControlConfiguration
								id=\\"fin.ar.lineitems.display.ValueHelpCompany\\" key=\\"CompanyCode\\"
								index=\\"1\\" groupId=\\"_BASIC\\" />
							<smartfilterbar:ControlConfiguration
								id=\\"fin.ar.lineitems.display.SelectClearingStatus\\" key=\\"CustomClearingStatus\\"
								label=\\"{i18nLib>LABEL_CLEARINGSTATUS}\\" controlType=\\"dropDownList\\"
								index=\\"2\\" groupId=\\"_BASIC\\" mandatory=\\"mandatory\\">
								<smartfilterbar:customControl>
									<Select id=\\"fin.ar.lineitems.display.CustomSelectClearingStatus\\"
										selectedKey=\\"O\\" change=\\"onClearingStatusChange\\"
										ariaLabelledBy=\\"fin.ar.lineitems.display.InvisibleText.ClearingStatus\\">
										<core:Item key=\\"O\\" id=\\"fin.ar.lineitems.display.item.SelectClearingStatusOpen\\" text=\\"{i18nLib>SELECT_CLEARINGSTATUS_OPEN}\\" />
										<core:Item key=\\"C\\" id=\\"fin.ar.lineitems.display.item.SelectClearingStatusCleared\\" text=\\"{i18nLib>SELECT_CLEARINGSTATUS_CLEARED}\\" />
										<core:Item key=\\"A\\" id=\\"fin.ar.lineitems.display.item.SelectClearingStatusAll\\" text=\\"{i18nLib>SELECT_CLEARINGSTATUS_ALL}\\" />
									</Select>
								</smartfilterbar:customControl>
							</smartfilterbar:ControlConfiguration>
							<smartfilterbar:ControlConfiguration
								id=\\"fin.ar.lineitems.display.DateClearingDate\\" key=\\"ClearingDate\\"
								conditionType=\\"{module: 'sap.fin.central.lib.daterange.FiscalDateRangeType', entitySetForFiscalYearVariant: 'CompanyCodeForFiscalYearVariantSet'}\\"
								index=\\"3\\" groupId=\\"_BASIC\\" visible=\\"false\\" />
							<smartfilterbar:ControlConfiguration
								id=\\"fin.ar.lineitems.display.DateKeyDate\\" key=\\"KeyDate\\"
								controlType=\\"date\\" filterType=\\"single\\" index=\\"4\\" hasTypeAhead=\\"false\\" groupId=\\"_BASIC\\" />
							<smartfilterbar:ControlConfiguration
								id=\\"fin.ar.lineitems.display.DateEntryDate\\" key=\\"AccountingDocumentCreationDate\\"
								controlType=\\"date\\" filterType=\\"interval\\" index=\\"5\\" hasTypeAhead=\\"false\\"
								groupId=\\"fin.ar.lineitems.display.AccountingDocumentGroup\\" />
							<smartfilterbar:ControlConfiguration
								id=\\"fin.ar.lineitems.display.InputFiscalYearPeriodInterval\\" key=\\"FiscalYearPeriod\\"
								controlType=\\"input\\" index=\\"6\\" groupId=\\"_BASIC\\" visible=\\"false\\" />
							<smartfilterbar:ControlConfiguration
								id=\\"fin.ar.lineitems.display.DatePostingDate\\" key=\\"PostingDate\\"
								conditionType=\\"{module: 'sap.fin.central.lib.daterange.FiscalDateRangeType', entitySetForFiscalYearVariant: 'CompanyCodeForFiscalYearVariantSet'}\\"
								index=\\"7\\" groupId=\\"_BASIC\\" visible=\\"false\\" />
							<smartfilterbar:ControlConfiguration
								id=\\"fin.ar.lineitems.display.MultiComboBoxDueItemCategory\\" key=\\"DueItemCategory\\"
								label=\\"{i18nLib>LABEL_ACCDOCTYPE}\\" controlType=\\"dropDownList\\" width=\\"20em\\"
								hasValueHelpDialog=\\"false\\" index=\\"8\\" groupId=\\"_BASIC\\" mandatory=\\"mandatory\\">
								<smartfilterbar:customControl>
									<MultiComboBox
										id=\\"fin.ar.lineitems.display.CustomMultiComboBoxDueItemCategory\\"
										selectionChange=\\"onTypeSelectionChange\\"
										customData:hasValue=\\"true\\"
										ariaLabelledBy=\\"fin.ar.lineitems.display.InvisibleText.AccountingDocumentType\\">
										<items>
											<core:Item id=\\"fin.ar.lineitems.display.ItemNormal\\"
												key=\\"N\\" text=\\"{i18n>CUSTOMER_ITEM_TYPE_NORMAL}\\" />
											<core:Item id=\\"fin.ar.lineitems.display.ItemSpecialGL\\"
												key=\\"S\\" text=\\"{i18n>CUSTOMER_ITEM_TYPE_SPECIAL_GL}\\" />
											<core:Item id=\\"fin.ar.lineitems.display.ItemNoted\\"
												key=\\"M\\" text=\\"{i18n>CUSTOMER_ITEM_TYPE_NOTED}\\" />
											<core:Item id=\\"fin.ar.lineitems.display.ItemParked\\"
												key=\\"P\\" text=\\"{i18n>CUSTOMER_ITEM_TYPE_PARKED}\\" />
											<core:Item id=\\"fin.ar.lineitems.display.ItemVendor\\"
												key=\\"V\\" text=\\"{i18n>CUSTOMER_ITEM_TYPE_VENDOR}\\" />
										</items>
									</MultiComboBox>
								</smartfilterbar:customControl>
							</smartfilterbar:ControlConfiguration>
							<smartfilterbar:ControlConfiguration
								id=\\"fin.ar.lineitems.display.ValueHelpCompanyName\\" key=\\"CompanyName\\"
								visible=\\"false\\" groupId=\\"fin.ar.lineitems.display.AccountingDocumentGroup\\" />
							<smartfilterbar:ControlConfiguration
								id=\\"fin.ar.lineitems.display.ValueHelpPostingKey\\" key=\\"PostingKey\\"
								groupId=\\"fin.ar.lineitems.display.AccountingDocumentGroup\\"
								preventInitialDataFetchInValueHelpDialog=\\"false\\" />
							<smartfilterbar:ControlConfiguration
								id=\\"fin.ar.lineitems.display.ValueHelpAccountingDocumentType\\"
								key=\\"AccountingDocumentType\\" groupId=\\"fin.ar.lineitems.display.AccountingDocumentGroup\\"
								preventInitialDataFetchInValueHelpDialog=\\"false\\" />
							<smartfilterbar:ControlConfiguration
								id=\\"fin.ar.lineitems.display.ValueHelpSpecialGLCode\\" key=\\"SpecialGeneralLedgerCode\\"
								groupId=\\"fin.ar.lineitems.display.AccountingDocumentGroup\\"
								hasTypeAhead=\\"false\\" visible=\\"true\\"
								preventInitialDataFetchInValueHelpDialog=\\"false\\" />
							<smartfilterbar:ControlConfiguration
								id=\\"fin.ar.lineitems.display.ValueHelpDunningBlockingReasonCode\\"
								key=\\"DunningBlockingReasonCode\\" groupId=\\"fin.ar.lineitems.display.DunningGroup\\"
								preventInitialDataFetchInValueHelpDialog=\\"false\\" />
							<smartfilterbar:ControlConfiguration
								id=\\"fin.ar.lineitems.display.InputMaximumDunningLevel\\" key=\\"MaximumDunningLevel\\"
								groupId=\\"fin.ar.lineitems.display.DunningGroup\\"
								preventInitialDataFetchInValueHelpDialog=\\"false\\" />
							<smartfilterbar:ControlConfiguration
								id=\\"fin.ar.lineitems.display.InputDunningLevel\\" key=\\"DunningLevel\\"
								groupId=\\"fin.ar.lineitems.display.DunningGroup\\"
								displayBehaviour=\\"idOnly\\"
								preventInitialDataFetchInValueHelpDialog=\\"false\\" />
							<smartfilterbar:ControlConfiguration
								id=\\"fin.ar.lineitems.display.ValueHelpPaymentBlockingReason\\" key=\\"PaymentBlockingReason\\"
								groupId=\\"fin.ar.lineitems.display.PaymentGroup\\"
								preventInitialDataFetchInValueHelpDialog=\\"false\\" />
						</smartfilterbar:controlConfiguration>
					</smartfilterbar:SmartFilterBar>
				</f:content>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<smarttable:SmartTable id=\\"fin.ar.lineitems.display.SmartTableItems\\"
				entitySet=\\"Items\\" smartFilterId=\\"fin.ar.lineitems.display.SmartFilterBar\\"
				tableType=\\"AnalyticalTable\\"
				header=\\"{i18nLib>ITEMS_COUNT_INITIAL}\\"
				dataReceived=\\"onDataReceived\\"
				ignoredFields=\\"CustomerSupplierAccount,GeneratedID,BooleanParameter,TuningParameter1,TuningParameter2,Customer,CustomerName,CompanyCode,CompanyName,ClearingStatus,AssignmentReference,AccountingDocument,AccountingDocumentItem,AccountingDocumentType,DocumentDate,SpecialGeneralLedgerCode,DueNetSymbol,CashDateDueNetSymbol,ClearingAccountingDocument,ClearingDocFiscalYear,DocumentItemText,FiscalYear,HasClearingAccountingDocument,ETag,CaseID\\"
				initiallyVisibleFields=\\"AmountInCompanyCodeCurrency\\"
				beforeRebindTable=\\"onBeforeRebindTable\\" afterVariantSave=\\"onAfterTableVariantSave\\" afterVariantApply=\\"onAfterTableVariantApply\\"
				persistencyKey=\\"fin.ar.line.items.display.TablePersoKey\\"
				showOverlay=\\"onShowOverlay\\"
				beforeExport=\\"onBeforeExport\\"
				customData:p13nDialogSettings='\\\\{\\"columns\\":\\\\{\\"visible\\": true, \\"payload\\": \\\\{\\"visibleItemsThreshold\\": 100\\\\}\\\\}\\\\}' >
				<smarttable:customData>
					<core:CustomData id=\\"fin.ar.lineitems.display.st.cd.dateFormatSettings\\" key=\\"dateFormatSettings\\"
						value='\\\\{\\"UTC\\":true,\\"style\\":\\"short\\"\\\\}' />
				</smarttable:customData>
				<smarttable:layoutData>
					<FlexItemData id=\\"fin.ar.lineitems.display.st.FlexItemData\\" growFactor=\\"1\\" baseSize=\\"0%\\" />
				</smarttable:layoutData>
				<smarttable:semanticObjectController>
					<smartlink:SemanticObjectController
						id=\\"fin.ar.lineitems.display.SemanticObjectController\\"
						beforePopoverOpens=\\"onBeforePopoverOpens\\"
						navigationTargetsObtained=\\"onNavTargetsObtained\\" navigate=\\"onPopoverLinkPressed\\"
						prefetchDone=\\"onPrefetchNavTargets\\" ignoredFields=\\"\\"
						prefetchNavigationTargets=\\"true\\" />
				</smarttable:semanticObjectController>
				
				<smarttable:customToolbar >
					<OverflowToolbar id=\\"fin.ar.lineitems.display.OverflowToolbar\\" design=\\"Transparent\\">
						<ToolbarSpacer id=\\"fin.ar.lineitems.display.st.OverflowToolbarSpacer\\" />
							
						<core:ExtensionPoint name=\\"fin.ar.lineitems.display.ExtensionPointTableToolbar\\" />
							
						<Button id=\\"fin.ar.lineitems.display.ChangeButton\\" type=\\"Transparent\\" enabled=\\"false\\"
							text=\\"{i18nLib>BUTTON_CHANGE_DOCUMENTS}\\" press=\\"onButtonPressedChangeDocument\\" 
							fieldGroupIds=\\"enableIfAtLeastOneRowSelected\\" >
						</Button>

						<Button id=\\"fin.ar.lineitems.display.ButtonCreateCorrespondence\\" type=\\"Transparent\\" enabled=\\"false\\"
							text=\\"{i18nLib>BUTTON_SEND_CORRESPONDENCE}\\" press=\\"onButtonPressedSendCorrespondence\\" 
							visible=\\"{SupportedNavigations>/Correspondence-create/supported}\\"
							fieldGroupIds=\\"enableIfExactlyOneRowSelected\\" >
						</Button>

						<Button id=\\"fin.ar.lineitems.display.ButtonBlockDunning\\" type=\\"Transparent\\" enabled=\\"false\\"
							text=\\"{i18n>BUTTON_BLOCK_DUNNING}\\" press=\\"onButtonPressedDunningBlock\\"
							fieldGroupIds=\\"enableIfAtLeastOneRowSelected\\" >
						</Button>

						<Button id=\\"fin.ar.lineitems.display.ButtonUnblockDunning\\" type=\\"Transparent\\" enabled=\\"false\\"
							text=\\"{i18n>BUTTON_UNBLOCK_DUNNING}\\" press=\\"onButtonPressedDunningUnblock\\"
							fieldGroupIds=\\"enableIfAtLeastOneRowSelected\\" >
						</Button>

						<Button id=\\"fin.ar.lineitems.display.ButtonBlockPayment\\" type=\\"Transparent\\" enabled=\\"false\\"
							text=\\"{i18nLib>BUTTON_BLOCK_PAYMENT}\\" press=\\"onButtonPressedPaymentBlock\\"
							fieldGroupIds=\\"enableIfAtLeastOneRowSelected\\" >
						</Button>

						<Button id=\\"fin.ar.lineitems.display.ButtonUnblockPayment\\" type=\\"Transparent\\" enabled=\\"false\\"
							text=\\"{i18nLib>BUTTON_UNBLOCK_PAYMENT}\\" press=\\"onButtonPressedPaymentUnblock\\"
							fieldGroupIds=\\"enableIfAtLeastOneRowSelected\\" >
						</Button>

					</OverflowToolbar>
				</smarttable:customToolbar>


				<table:AnalyticalTable id=\\"fin.ar.lineitems.display.TableItems\\"
					enableColumnReordering=\\"true\\" showColumnVisibilityMenu=\\"false\\"
					enableColumnFreeze=\\"false\\" enableCellFilter=\\"true\\"
					visibleRowCountMode=\\"Auto\\" group=\\"onTableGrouped\\">
					
					<table:plugins>
						<plugins:MultiSelectionPlugin
							id=\\"fin.ar.lineitems.display.MultiSelectionPlugin\\"
							limit=\\"50\\" enableNotification=\\"true\\" 
							selectionChange=\\"onRowSelectionChange\\"/>
					</table:plugins>

