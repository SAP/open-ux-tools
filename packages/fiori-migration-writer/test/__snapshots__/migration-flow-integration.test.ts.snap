  ],
  \\"main\\": \\"webapp/index.html\\",
  \\"scripts\\": {
    \\"start_old\\": \\"fiori run --open \\\\\\"test/flpSandbox.html?sap-client=928&sap-ui-xx-viewCache=false#C_DefectRecord-display\\\\\\"\\",
    \\"start-local_old\\": \\"fiori run --config ./ui5-local.yaml --open \\\\\\"test/flpSandboxMockServer.html?sap-client=928&sap-ui-xx-viewCache=false#masterDetail-display\\\\\\"\\",
    \\"start-noflp_old\\": \\"fiori run --open \\\\\\"index.html?sap-client=928&sap-ui-xx-viewCache=false\\\\\\"\\",
    \\"start-variants-management_old\\": \\"fiori run --open \\\\\\"preview.html?sap-client=928&sap-ui-xx-viewCache=false&fiori-tools-rta-mode=true&sap-ui-rta-skip-flex-validation=true#preview-app\\\\\\"\\",
    \\"build_old\\": \\"ui5 build -a --clean-dest --include-task=generateCachebusterInfo\\",
    \\"deploy_old\\": \\"fiori verify\\",
    \\"deploy-config_old\\": \\"fiori add deploy-config\\",
    \\"start-mock_old\\": \\"fiori run --open \\\\\\"test/flpSandboxMockServer.html?sap-client=928&sap-ui-xx-viewCache=false#masterDetail-display\\\\\\"\\",
    \\"suite-tests_old\\": \\"fiori run --open \\\\\\"test/testsuite.qunit.html\\\\\\"\\",
    \\"unit-tests_old\\": \\"fiori run --open \\\\\\"test/unit/unitTests.qunit.html\\\\\\"\\",
    \\"int-tests_old\\": \\"fiori run --open \\\\\\"test/integration/opaTests.qunit.html\\\\\\"\\",
    \\"start\\": \\"fiori run --open \\\\\\"test/flpSandbox.html?sap-client=928&sap-ui-xx-viewCache=false#C_DefectRecord-display\\\\\\"\\",
    \\"start-local\\": \\"fiori run --config ./ui5-local.yaml --open \\\\\\"test/flpSandboxMockServer.html?sap-client=928&sap-ui-xx-viewCache=false#masterDetail-display\\\\\\"\\",
    \\"start-noflp\\": \\"fiori run --open \\\\\\"index.html?sap-client=928&sap-ui-xx-viewCache=false\\\\\\"\\",
    \\"start-variants-management\\": \\"fiori run --open \\\\\\"preview.html?sap-client=928&sap-ui-xx-viewCache=false&fiori-tools-rta-mode=true&sap-ui-rta-skip-flex-validation=true#preview-app\\\\\\"\\",
