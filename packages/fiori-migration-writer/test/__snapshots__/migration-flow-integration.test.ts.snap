  "webapp/test/qunit/qunit.runner.testsuite.html": Object {
    "contents": "<html>
<head>
<title>TestSuite for Customer Line Items Coverage Analysis</title> -->
<!--  Warning! The file name is fixed centrally! 
see also https://wiki.wdf.sap.corp/wiki/display/fiorisuite/QUnit+for+Fiori+JavaScript+unit+testing
-->
</head>
<body>
    <script language=\\"javascript\\">
        /**
         * Add test pages to this test suite function.
         * Please order alphabetically
         */
        function suite() {
            var suite = new top.jsUnitTestSuite();
            var contextPath = \\"/\\" + window.location.pathname.split(\\"/\\")[1];
            suite.addTestPage(contextPath + \\"/test-resources/testsuite.unit.html\\");
            suite.addTestPage(contextPath + \\"/test-resources/testsuite.unit.withenv.html\\");
            return suite;
        }
        redirectToTestrunnerIfRequired();
    </script>
</body>
</html>",
