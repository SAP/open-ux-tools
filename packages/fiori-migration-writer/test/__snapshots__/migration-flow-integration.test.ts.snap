				<Property Name=\\"Documentnumber\\" Type=\\"Edm.String\\" Nullable=\\"false\\" MaxLength=\\"25\\" sap:label=\\"Dokument\\" sap:updatable=\\"false\\"
					sap:sortable=\\"false\\" sap:filterable=\\"false\\"/>
