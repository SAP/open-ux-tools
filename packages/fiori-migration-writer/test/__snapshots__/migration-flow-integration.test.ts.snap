				</Annotation><Annotation Term=\\"Common.SemanticObject\\" String=\\"EPMProduct\\"/></Annotations>
			<Annotations xmlns=\\"http://docs.oasis-open.org/odata/ns/edm\\" Target=\\"SEPMRA_PROD_MAN.SEPMRA_C_PD_ProductTextType\\">
