</head>
<body class=\\"sapUiBody sapUiSizeCompact\\" id=\\"content\\">
<div data-sap-ui-component data-name=\\"migration_test01\\" data-id=\\"container\\" data-settings='{\\"id\\" : \\"migration_test01\\"}' data-handle-validation=\\"true\\"></div>
</body>
</html>
