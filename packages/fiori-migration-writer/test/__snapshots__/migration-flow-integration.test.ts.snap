  "webapp/test/integration/opaTests.qunit.js": Object {
    "contents": "/* global QUnit */

QUnit.config.autostart = false;

sap.ui.getCore().attachInit(function () {
    'use strict';

    sap.ui.require(['sap/ui/demo/todo/test/integration/AllJourneys'], function () {
        QUnit.start();
    });
