#XFLD:
TABLE_COLUMN_FILTER_TEXT=Filter
#YMSG:
DOWNLOAD_CONFIRMATION_TEXT=The table contains {0}  rows and therefore the download may take a while to complete. Do you really want to start the download?
#XFLD: Export button
TABLE_EXPORT_TEXT=Export to Spreadsheet 
#XBUT: Add button on S1
BTN_ADD=Add
#XBUT: Display button on S1
BTN_DISPLAY=Display
#XBUT: Copy button on S2
BTN_COPY=Copy
#XBUT: Delete button on S1
BTN_DEL=Delete
#XBUT: Edit button on S2
BTN_EDIT=Edit
#XBUT: Save button on S3
BTN_SAVE=Save
#XBUT: OK button
BTN_OK=OK
#XBUT: CANCEL button, general
BTN_CANCEL=Cancel
#XBUT: Reset button in Filter Bar
BTN_RESET=Reset
#XBUT: Search button in Filter Bar
BTN_SEARCH=Search
#XTIT: Personalize button tooltip
Personalization=Personalization
#XFLD: Variant control label
VARIANT_LABEL=Layout Variant

#XFLD: noData Text
NO_DATA_A=No items selected. To start, enter your selection criteria and run the search.
#XFLD: noData Text
NO_DATA_B=No items selected. Check the search and filter settings.
#XFLD: noData Text
NO_DATA_C=No results found. Try adjusting your search and filter settings.
#XFLD: noData Text
NO_DATA_D=Loading ... 
#XTIT: noData Text
TABLETITLE=Search results 

#@################ Dialog ##############################

#XFLD: label of controlling area
C_CTRL_AREA=Controlling Area
#XTIT: dialog title for Set Controlling Area
SET_CONTROLLING_AREA_TITLE=Set Controlling Area
#XTIT: dialog title for Select Controlling Area
