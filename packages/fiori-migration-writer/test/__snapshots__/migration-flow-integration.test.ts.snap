  "ui5-local.yaml": Object {
    "contents": "specVersion: \\"4.0\\"
metadata:
  name: com.example.legacy.costcenter
type: application
framework:
  name: SAPUI5
  version: 1.153.0
  libraries:
    - name: sap.m
    - name: sap.me
    - name: sap.ui.table
    - name: sap.ui.comp
    - name: sap.ui.unified
    - name: sap.ui.generic.app
    - name: sap.ui.layout
    - name: sap.ca.scfld.md
    - name: sap.collaboration
    - name: sap.f
    - name: sap.ui.core
    - name: sap.ushell
    - name: themelib_sap_bluecrystal
    - name: themelib_sap_horizon
server:
  customMiddleware:
    - name: fiori-tools-proxy
      afterMiddleware: compression
      configuration:
        ignoreCertErrors: false
        backend:
          - path: /sap
            url: https://backend.example.com:44300
            destination: BACKEND_DUMMY
          - path: /resources/sap/fin/central/lib
            destination: BACKEND_DUMMY
            url: https://backend.example.com:44300
            pathPrefix: /sap/bc/ui5_ui5/sap/FIN_LIB/sap/fin/central/lib
    - name: fiori-tools-appreload
      afterMiddleware: compression
      configuration:
        port: 35729
        path: webapp
        delay: 300
    - name: fiori-tools-preview
      afterMiddleware: fiori-tools-appreload
      configuration:
        component: com.example.legacy.costcenter
        ui5Theme: sap_horizon
",
    "state": "modified",
  },
  "ui5.yaml": Object {
    "contents": "specVersion: \\"4.0\\"
metadata:
  name: com.example.legacy.costcenter
type: application
server:
  customMiddleware:
    - name: fiori-tools-proxy
      afterMiddleware: compression
      configuration:
        ignoreCertErrors: false
        backend:
          - path: /sap
            url: https://backend.example.com:44300
            destination: BACKEND_DUMMY
          - path: /resources/sap/fin/central/lib
            destination: BACKEND_DUMMY
            url: https://backend.example.com:44300
            pathPrefix: /sap/bc/ui5_ui5/sap/FIN_LIB/sap/fin/central/lib
        ui5:
          path:
            - /resources
            - /test-resources
          url: https://ui5.sap.com
    - name: fiori-tools-appreload
      afterMiddleware: compression
      configuration:
        port: 35729
        path: webapp
        delay: 300
    - name: fiori-tools-preview
      afterMiddleware: fiori-tools-appreload
      configuration:
        component: com.example.legacy.costcenter
        ui5Theme: sap_horizon
",
    "state": "modified",
  },
