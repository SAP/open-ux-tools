    \\"@sap/ux-ui5-tooling\": \"^1.33.0\",
    \\"rimraf\\": \\"6.0.1\\"
  },
  \\"scripts\\": {
    \\"build_old\\": \\"ui5 build --clean-dest --include-task=generateCachebusterInfo\\",
    \\"start_old\\": \\"fiori run --open \\\\\\"test/flpSandbox.html?sap-client=815&sap-ui-xx-viewCache=false#OVP-display\\\\\\"\\",
    \\"start-local_old\\": \\"fiori run --config ./ui5-local.yaml --open \\\\\\"test/flpSandboxMockServer.html?sap-client=815&sap-ui-xx-viewCache=false#OVP-display\\\\\\"\\",
    \\"start-noflp_old\\": \\"fiori run --open \\\\\\"index.html?sap-client=815&sap-ui-xx-viewCache=false\\\\\\"\\",
    \\"start-variants-management_old\\": \\"fiori run --open \\\\\\"preview.html?sap-client=815&sap-ui-xx-viewCache=false&fiori-tools-rta-mode=true&sap-ui-rta-skip-flex-validation=true#preview-app\\\\\\"\\",
    \\"deploy_old\\": \\"fiori verify\\",
    \\"deploy-config_old\\": \\"fiori add deploy-config\\",
    \\"start-mock_old\\": \\"fiori run --open \\\\\\"test/flpSandboxMockServer.html?sap-client=815&sap-ui-xx-viewCache=false#OVP-display\\\\\\"\\",
    \\"start\\": \\"fiori run --open \\\\\\"test/flpSandbox.html?sap-client=815&sap-ui-xx-viewCache=false#OVP-display\\\\\\"\\",
    \\"start-local\\": \\"fiori run --config ./ui5-local.yaml --open \\\\\\"test/flpSandboxMockServer.html?sap-client=815&sap-ui-xx-viewCache=false#OVP-display\\\\\\"\\",
    \\"start-noflp\\": \\"fiori run --open \\\\\\"index.html?sap-client=815&sap-ui-xx-viewCache=false\\\\\\"\\",
    \\"start-variants-management\\": \\"fiori run --open \\\\\\"preview.html?sap-client=815&sap-ui-xx-viewCache=false&fiori-tools-rta-mode=true&sap-ui-rta-skip-flex-validation=true#preview-app\\\\\\"\\",
