				<Property Name=\\"Laboratory\\" Type=\\"Edm.String\\" MaxLength=\\"3\\" sap:label=\\"Labor oder Büro\\" sap:sortable=\\"false\\" sap:filterable=\\"false\\"/>
				<Property Name=\\"Ecnumber\\" Type=\\"Edm.String\\" MaxLength=\\"12\\" sap:label=\\"Ändnr.\\" sap:sortable=\\"false\\" sap:filterable=\\"false\\"/>
