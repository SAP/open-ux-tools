  "webapp_custom/manifest.json": Object {
    "contents": "{
  \\"_version\\": \\"1.15.0\\",
  \\"sap.app\\": {
    \\"id\\": \\"namespace3.v4catalog\\",
    \\"type\\": \\"application\\",
    \\"i18n\\": \\"i18n/i18n.properties\\",
    \\"applicationVersion\\": {
      \\"version\\": \\"1.0.0\\"
    },
    \\"title\\": \\"{{appTitle}}\\",
    \\"description\\": \\"{{appDescription}}\\",
    \\"ach\\": \\"CA-UI5-FE\\",
    \\"dataSources\\": {
      \\"mainService\\": {
        \\"uri\\": \\"/catalog-admin-noauth/\\",
        \\"type\\": \\"OData\\",
        \\"settings\\": {
          \\"annotations\\": [
            \\"annotation\\"
          ],
          \\"odataVersion\\": \\"4.0\\",
          \\"localUri\\": \\"localService/metadata.xml\\"
        }
      },
      \\"annotation\\": {
        \\"type\\": \\"ODataAnnotation\\",
        \\"uri\\": \\"annotations/annotation.xml\\",
        \\"settings\\": {
          \\"localUri\\": \\"annotations/annotation.xml\\"
        }
      }
    },
    \\"offline\\": false,
    \\"resources\\": \\"resources.json\\",
    \\"sourceTemplate\\": {
      \\"id\\": \\"ui5template.fiorielements.v4.lrop\\",
      \\"version\\": \\"1.0.0\\",
      \\"toolsId\\": \\"<generated-uuid>\\"
    }
  },
  \\"sap.ui\\": {
    \\"technology\\": \\"UI5\\",
    \\"icons\\": {
      \\"icon\\": \\"\\",
      \\"favIcon\\": \\"\\",
      \\"phone\\": \\"\\",
      \\"phone@2\\": \\"\\",
      \\"tablet\\": \\"\\",
      \\"tablet@2\\": \\"\\"
    },
    \\"deviceTypes\\": {
      \\"desktop\\": true,
      \\"tablet\\": true,
      \\"phone\\": true
    }
  },
  \\"sap.ui5\\": {
    \\"resources\\": {
      \\"js\\": [],
      \\"css\\": []
    },
    \\"dependencies\\": {
      \\"minUI5Version\\": \\"1.76.0\\",
      \\"libs\\": {
        \\"sap.ui.core\\": {},
        \\"sap.fe.templates\\": {}
      }
    },
    \\"models\\": {
      \\"i18n\\": {
        \\"type\\": \\"sap.ui.model.resource.ResourceModel\\",
        \\"uri\\": \\"i18n/i18n.properties\\"
      },
      \\"\\": {
        \\"dataSource\\": \\"mainService\\",
        \\"settings\\": {
          \\"synchronizationMode\\": \\"None\\",
          \\"operationMode\\": \\"Server\\",
          \\"autoExpandSelect\\": true,
          \\"earlyRequests\\": true
        }
      }
    },
    \\"routing\\": {
      \\"targets\\": {
        \\"ProductsList\\": {
          \\"type\\": \\"Component\\",
          \\"id\\": \\"ProductsList\\",
          \\"name\\": \\"sap.fe.templates.ListReport\\",
          \\"options\\": {
            \\"settings\\": {
              \\"entitySet\\": \\"Products\\",
              \\"variantManagement\\": \\"Page\\",
              \\"navigation\\": {
                \\"Products\\": {
                  \\"detail\\": {
                    \\"route\\": \\"ProductsObjectPage\\"
                  }
                }
              }
            }
          }
        },
        \\"ProductsObjectPage\\": {
          \\"type\\": \\"Component\\",
          \\"id\\": \\"ProductsObjectPage\\",
          \\"name\\": \\"sap.fe.templates.ObjectPage\\",
          \\"options\\": {
            \\"settings\\": {
              \\"entitySet\\": \\"Products\\",
              \\"navigation\\": {}
            }
          }
        }
      },
      \\"routes\\": [
        {
          \\"pattern\\": \\":?query:\\",
          \\"name\\": \\"ProductsList\\",
          \\"target\\": \\"ProductsList\\"
        },
        {
          \\"pattern\\": \\"Products({key}):?query:\\",
          \\"name\\": \\"ProductsObjectPage\\",
          \\"target\\": \\"ProductsObjectPage\\"
        }
      ]
    },
    \\"contentDensities\\": {
      \\"compact\\": true,
      \\"cozy\\": true
    }
  },
  \\"sap.platform.abap\\": {
    \\"_version\\": \\"1.1.0\\",
    \\"uri\\": \\"\\"
  },
  \\"sap.platform.hcp\\": {
    \\"_version\\": \\"1.1.0\\",
    \\"uri\\": \\"\\"
  },
  \\"sap.fiori\\": {
    \\"_version\\": \\"1.1.0\\",
    \\"registrationIds\\": [],
    \\"archeType\\": \\"transactional\\"
  }
}
