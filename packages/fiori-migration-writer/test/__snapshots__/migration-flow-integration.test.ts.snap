  },
  "webapp/test/qunit/testsuite.unit.html": Object {
    "contents": "<!DOCTYPE HTML>
<html>
<!--  see also https://wiki.wdf.sap.corp/wiki/display/fiorisuite/QUnit+for+Fiori+JavaScript+unit+testing -->
