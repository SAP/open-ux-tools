					sap:semantics=\\"description\\"/>
				<Property Name=\\"Username\\" Type=\\"Edm.String\\" Nullable=\\"false\\" MaxLength=\\"12\\" sap:label=\\"Benutzer\\" sap:creatable=\\"false\\" sap:updatable=\\"false\\"
