/**
 * Test constants and project configurations
 * Similar to tools-suite test/common/constants.ts
 */

export interface MigrationTestProjectInfo {
    subDir: string;
    projectRoot?: string;
    baseUri: string;
    destination?: string;
    sapClient?: string;
    scp?: boolean;
}

export interface TestProjectInfo {
    [key: string]: {
        MIGRATION: MigrationTestProjectInfo;
    };
}

