					<translationDomain>CA</translationDomain>
					<translationDeveloper>D053850</translationDeveloper>
					<translationCollection>SSUITE_FMREUSE</translationCollection>
					<translationResources>
						<translationResource>src/i18n</translationResource>
					</translationResources>
				</configuration>
			</plugin>
